{
  "expo": {
    "name": "Kiorex",
    "slug": "kiorex",
    "version": "0.1.0",
    "scheme": "kiorex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F6FC",
    "ios": {
      "bundleIdentifier": "com.kiorex.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Kiorex uses the camera so your doctor can see you during a video visit. The call is private and not recorded.",
        "NSMicrophoneUsageDescription": "Kiorex uses the microphone so your doctor can hear you during a video visit. The call is private and not recorded."
      }
    },
    "android": {
      "package": "com.kiorex.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#3730A3"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ar": "./src/i18n/infoplist/ar.json",
      "en": "./src/i18n/infoplist/en.json"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidDefaultStrings.js",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#3730A3",
          "dark": {
            "backgroundColor": "#0F1024",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3730A3"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kiorex needs access to your photos so you can add a record to your private vault.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "storeAccounts": "NEEDS_HUMAN: bundle ids com.kiorex.app are placeholders until Apple/Google accounts exist (KX-19)"
    }
  }
}
