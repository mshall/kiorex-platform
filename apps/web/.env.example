# Kiorex patient web: optional build-time settings (Vite). Nothing here is a secret; map keys must be browser-restricted public keys.

# Map (KXMDS05, MapLibre GL). Provider: mock (default, offline-safe, no network) | osm | style | amazon
VITE_MAP_PROVIDER=mock
# osm: raster tile template (the public OSM server is for development only; use a provider whose policy allows production traffic)
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# style: any MapLibre style JSON (self-hosted / Protomaps / MapTiler)
# VITE_MAP_STYLE_URL=https://maps.example.com/style.json
# amazon (optional adapter, needs the Amazon Location go-live pass): style descriptor URL incl. the restricted API key
# VITE_AMAZON_LOCATION_STYLE_URL=https://maps.geo.eu-central-1.amazonaws.com/v2/styles/Standard/descriptor?key=...
# Arabic labels on vector styles: MapLibre RTL text plugin script URL (optional)
# VITE_MAP_RTL_TEXT_PLUGIN_URL=https://unpkg.com/@mapbox/mapbox-gl-rtl-text@0.3.0/dist/mapbox-gl-rtl-text.js
# VITE_MAP_DEFAULT_CENTER=31.2357,30.0444

# WhatsApp booking entry (KXM-BK-11): Kiorex's WhatsApp Business number, digits only with country code. Unset = the Services card says the number will be announced at launch (NEEDS_HUMAN #5, real provider go-live).
# VITE_WHATSAPP_NUMBER=201000000000
