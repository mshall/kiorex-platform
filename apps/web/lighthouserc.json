{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4000/ar/eg",
        "http://localhost:4000/ar/eg/doctors/cardiology/cairo",
        "http://localhost:4000/ar/eg/locations/cairo",
        "http://localhost:4000/ar/eg/same-day/cardiology",
        "http://localhost:4000/ar/eg/doctor/__SLUG__"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "server-response-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "render-blocking-resources": [
          "error",
          {
            "maxLength": 0
          }
        ],
        "uses-text-compression": "off",
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 307200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  },
  "_comment": "GRW-P1-E budgets (ARCH section 5, work package E acceptance). Replace __SLUG__ with a seeded doctor slug; the three templates are home, listing and doctor. Field targets (p75 mobile, Egypt): LCP 2.5 s, INP 200 ms, CLS 0.1. Reports stay on the build agent (filesystem); a public upload target is NEEDS_HUMAN."
}
