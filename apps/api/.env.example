NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/kiorex_platform?schema=public
# TLS (staging/production RDS): append `&sslmode=verify-full` and set the CA bundle path with `&sslrootcert=/opt/rds/global-bundle.pem`
# or the env var below. Local dev: leave both unset (no TLS).
# DATABASE_SSL_CA=/opt/rds/global-bundle.pem   # PGSSLROOTCERT is accepted too; sslrootcert in the URL wins
# Pool size (Prisma 7 + pg adapter): `connection_limit=N` in the URL caps the pool; without it the pool uses DB_POOL_MAX, else 10 (explicit default).
# The shared local cluster has max_connections=100: seeds/tests use connection_limit=2..3; long-running APIs keep the default 10.
# Identity (Kiorex Passport)
OIDC_ISSUER=http://localhost:4400
OIDC_AUDIENCE=kiorex-api
# Kiorly marketplace client
KIORLY_BASE_URL=http://localhost:3010/marketplace/v1
KIORLY_CLIENT_KEY=kx_dev_client
KIORLY_CLIENT_SECRET=kx_dev_secret_change_me
KIORLY_WEBHOOK_SECRET=kx_dev_webhook_secret
KIORLY_TIMEOUT_MS=8000
# Encryption of national ID at rest (32 bytes base64). NEVER reuse in production.
FIELD_ENCRYPTION_KEY=a2lvcmV4LWRldi1vbmx5LWZpZWxkLWtleS0zMmJ5dGU=
# Providers: SMS, EMAIL, WHATSAPP, PAYMENT. Each <KIND>_MODE=mock|real (default mock = no third party, dev inbox + dev simulators).
# Going live = set <KIND>_MODE=real plus the four values below (secrets come from Secrets Manager/SSM, never git). The API refuses to
# start when a real kind is missing any of them. Full contract: Docs/PROVIDERS.md. Legacy MESSAGING_MODE / PSP_MODE still work as aliases.
SMS_MODE=mock
# SMS_API_URL=https://sms-gateway.example.com/v1
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_WEBHOOK_SECRET=
# SMS_TIMEOUT_MS=8000
# SMS_MAX_RETRIES=2
EMAIL_MODE=mock
# EMAIL_API_URL=
# EMAIL_API_KEY=
# EMAIL_SENDER_ID=no-reply@kiorex.example
# EMAIL_WEBHOOK_SECRET=
WHATSAPP_MODE=mock
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
# WHATSAPP_SENDER_ID=<phone number id>
# WHATSAPP_WEBHOOK_SECRET also signs the normalised inbound-booking webhook (see below)
# WHATSAPP_TEMPLATE_MAP={"TODO_NEEDS_HUMAN_booking_confirmed":"kx_booking_confirmed_v1"}
PAYMENT_MODE=mock
# PAYMENT_API_URL=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
# Safety on-call paging in real mode = SMS to these numbers through the real SMS provider
SAFETY_DELIVERY_MODE=mock
# SAFETY_ONCALL_PHONES=+20100...,+20101...
# Mock-mode payment webhook secret (dev only)
PSP_FAKE_WEBHOOK_SECRET=psp_fake_secret_change_me
KIOREX_PAY_LINK_BASE_URL=http://localhost:4000/api/v1/pay/links
PUBLIC_BASE_URL=http://localhost:4000
# NEEDS_HUMAN: fee/deposit placeholders (KX-12). 0 = not charged / not invented.
PSP_FEE_BPS=0
DEPOSIT_DEFAULT_MINOR=0
# Business policies (default deposit = 10% of the consultation fee capped at 200 EGP for providers that enabled deposits; pro-rata partial pharmacy refunds) are
# PROPOSED_DEFAULT delegated by founder 23 Nov 2026 and live in PolicyService (ops console > Market policy), configurable per market / organisation. Not env values.
DEFAULT_MARKET=EG
POLICY_CACHE_SECONDS=30
# Video: mock (dev) | clinic-p2p (the Clinic owns the call: its own peer-to-peer WebRTC, Cloudflare TURN issued by the Clinic). No video vendor, no keys here.
# Storage: local | s3 (Docs/NEEDS_HUMAN.md Provider go-live)
VIDEO_MODE=mock
STORAGE_MODE=local
STORAGE_LOCAL_DIR=.data/vault
WHATSAPP_WEBHOOK_SECRET=wa_dev_webhook_secret_change_me
PUBLIC_APP_URL=https://kiorex.com/app
# KX-11 record shares (must equal Kiorly KIOREX_RECORD_SHARE_HMAC_SECRET) and prescription QR
KIOREX_RECORD_SHARE_HMAC_SECRET=dev-record-share-secret
RX_VERIFY_HMAC_SECRET=rx_dev_verify_secret_change_me
# Kiorly Pharmacy / Lab (DRAFT contracts, not built; see Docs/VERTICALS.md)
# Partner HOST only (PARTNER_API_PATH is appended). The PartnerRegistration table (seeded dev rows, ops-editable) takes precedence.
KIORLY_PHARMACY_BASE_URL=http://localhost:3100
KIORLY_PHARMACY_CLIENT_KEY=kx_dev_pharmacy_client
KIORLY_PHARMACY_CLIENT_SECRET=kx_dev_pharmacy_secret_change_me
KIORLY_PHARMACY_WEBHOOK_SECRET=kx_dev_pharmacy_webhook_secret
KIORLY_LAB_BASE_URL=http://localhost:3200
KIORLY_LAB_CLIENT_KEY=kl_dev_kiorex
KIORLY_LAB_CLIENT_SECRET=dev_kiorex_secret_change_me
KIORLY_LAB_WEBHOOK_SECRET=kx_dev_lab_webhook_secret
# NEEDS_HUMAN (KX-12): marketplace take (basis points), delivery/consult fees, VAT on OWN fee statements. 0 = unset, never invented.
PHARMACY_TAKE_RATE_BPS=0
LAB_TAKE_RATE_BPS=0
TELE_CONSULT_FEE_MINOR=0
PHARMACY_DELIVERY_FEE_MINOR=0
FEE_STATEMENT_VAT_BPS=0
KIORLY_ACCEPTS_WHATSAPP_CHANNEL=false
# AI
AI_PROVIDER=fake
AI_DAILY_QUOTA=20
OPENAI_EU_BASE_URL=
OPENAI_EU_API_KEY=
# Background jobs (set false in tests)
JOBS_ENABLED=true
# Control plane product keys: ff_<product>_dev / ff_dev_secret_change_me seeded by db:seed

# Partner lead signing (ADR-040 front door): verifies the signed 'Talk to us' leads and funnel markers sent by Kiorly Clinic / Pharmacy / Lab.
# Shared with the products as KIOREX_LEAD_SIGNING_SECRET. Outside production a FIXED DEV VALUE is used when unset; in production an unset or short
# (<32 chars) value makes the API refuse to start (health/ready shows leadSigning: configured / not configured, never the value).
# Production: AWS Secrets Manager /kiorex-platform/<env>/partner-lead-signing, written by scripts/setup-partner-lead-secret.sh <env>. Never put a value in git.
# Rotation window (script --rotate): the secret holds "<new>,<previous>"; both verify until --finish-rotation.
# PARTNER_LEAD_SIGNING_SECRET=
# PARTNER_LEAD_SIGNING_OPTIONAL=true   # set by OpenTofu only while the secret is not wired yet (staging bring-up)
