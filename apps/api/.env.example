NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/kiorex_platform?schema=public
# Pool size (Prisma 7 + pg adapter): `connection_limit=N` in the URL caps the pool; without it the pool uses DB_POOL_MAX, else 10 (explicit default).
# The shared local cluster has max_connections=100: seeds/tests use connection_limit=2..3; long-running APIs keep the default 10.
# Identity (Kiorex Passport)
OIDC_ISSUER=http://localhost:4400
OIDC_AUDIENCE=kiorex-api
# Kiorly marketplace client
KIORLY_BASE_URL=http://localhost:3010/marketplace/v1
KIORLY_CLIENT_KEY=kx_dev_client
KIORLY_CLIENT_SECRET=kx_dev_secret_change_me
KIORLY_WEBHOOK_SECRET=kx_dev_webhook_secret
KIORLY_TIMEOUT_MS=8000
# Encryption of national ID at rest (32 bytes base64). NEVER reuse in production.
FIELD_ENCRYPTION_KEY=a2lvcmV4LWRldi1vbmx5LWZpZWxkLWtleS0zMmJ5dGU=
# Payments
PSP_MODE=sandbox-fake
PSP_FAKE_WEBHOOK_SECRET=psp_fake_secret_change_me
KIOREX_PAY_LINK_BASE_URL=http://localhost:4000/api/v1/pay/links
PUBLIC_BASE_URL=http://localhost:4000
# NEEDS_HUMAN: fee/deposit placeholders (KX-12). 0 = not charged / not invented.
PSP_FEE_BPS=0
DEPOSIT_DEFAULT_MINOR=0
# Messaging / video / storage (mock = no third party; real = Docs/NEEDS_HUMAN.md Provider go-live)
MESSAGING_MODE=mock
VIDEO_MODE=mock
STORAGE_MODE=local
STORAGE_LOCAL_DIR=.data/vault
WHATSAPP_WEBHOOK_SECRET=wa_dev_webhook_secret_change_me
PUBLIC_APP_URL=https://kiorex.com/app
# KX-11 record shares (must equal Kiorly KIOREX_RECORD_SHARE_HMAC_SECRET) and prescription QR
KIOREX_RECORD_SHARE_HMAC_SECRET=dev-record-share-secret
RX_VERIFY_HMAC_SECRET=rx_dev_verify_secret_change_me
# Kiorly Pharmacy / Lab (DRAFT contracts, not built; see Docs/VERTICALS.md)
# Partner HOST only (PARTNER_API_PATH is appended). The PartnerRegistration table (seeded dev rows, ops-editable) takes precedence.
KIORLY_PHARMACY_BASE_URL=http://localhost:3100
KIORLY_PHARMACY_CLIENT_KEY=kx_dev_pharmacy_client
KIORLY_PHARMACY_CLIENT_SECRET=kx_dev_pharmacy_secret_change_me
KIORLY_PHARMACY_WEBHOOK_SECRET=kx_dev_pharmacy_webhook_secret
KIORLY_LAB_BASE_URL=http://localhost:3200
KIORLY_LAB_CLIENT_KEY=kl_dev_kiorex
KIORLY_LAB_CLIENT_SECRET=dev_kiorex_secret_change_me
KIORLY_LAB_WEBHOOK_SECRET=kx_dev_lab_webhook_secret
# NEEDS_HUMAN (KX-12): marketplace take (basis points), delivery/consult fees, VAT on OWN fee statements. 0 = unset, never invented.
PHARMACY_TAKE_RATE_BPS=0
LAB_TAKE_RATE_BPS=0
TELE_CONSULT_FEE_MINOR=0
PHARMACY_DELIVERY_FEE_MINOR=0
FEE_STATEMENT_VAT_BPS=0
KIORLY_ACCEPTS_WHATSAPP_CHANNEL=false
# AI
AI_PROVIDER=fake
AI_DAILY_QUOTA=20
OPENAI_EU_BASE_URL=
OPENAI_EU_API_KEY=
# Background jobs (set false in tests)
JOBS_ENABLED=true
# Control plane product keys: ff_<product>_dev / ff_dev_secret_change_me seeded by db:seed
