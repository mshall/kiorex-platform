{
  "name": "@kiorex/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kiorex marketplace API (NestJS modular monolith)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/lint-boundaries.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:contract": "jest --selectProjects integration --runInBand --testPathPattern contract",
    "test:flag-off": "jest --selectProjects integration --runInBand --testPathPattern flag-off",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:demo": "ts-node --transpile-only prisma/demo/seed-demo.ts",
    "db:test:prepare": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/kiorex_platform_test?schema=public prisma migrate deploy",
    "openapi:export": "nest build && node dist/openapi-export.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@kiorex/contracts": "file:../../../kiorex-contracts/dist-pack/kiorex-contracts-1.6.0.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}