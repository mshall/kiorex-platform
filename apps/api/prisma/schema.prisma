model AssistantToolCall {
  id               String   @id @default(cuid())
  turnId           String
  tool             String
  argsRedacted     Json     @default("{}")
  resultKind       String
  resultRef        String?
  confirmNonceHash String?
  createdAt        DateTime @default(now())

  turn AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([createdAt])
}

model AssistantUsageDaily {
  day            DateTime @db.Date
  market         String   @default("EG")
  tokens         Int      @default(0)
  costMinor      Int      @default(0)
  conversations  Int      @default(0)
  breakerTripped Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@id([day, market])
}

model AssistantEscalation {
  id        String   @id @default(cuid())
  sessionId String
  reason    String
  status    String   @default("OPEN") // OPEN ACKED CLOSED
  ackBy     String?
  slaDueAt  DateTime
  createdAt DateTime @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, slaDueAt])
}

/// One pull of a read-only marketing integration (mock first). Never stores credentials or response bodies.
model GrowthIntegrationRun {
  id         String    @id @default(cuid())
  market     String    @default("EG")
  kind       String
  mode       String    @default("mock")
  windowFrom DateTime? @db.Date
  windowTo   DateTime? @db.Date
  status     String // OK PARTIAL FAILED
  rows       Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([kind, startedAt])
}

model GrowthExternalMetricDaily {
  id           String   @id @default(cuid())
  market       String   @default("EG")
  kind         String
  day          DateTime @db.Date
  dimensionKey String   @default("")
  metric       String
  value        Decimal  @db.Decimal(20, 4)
  currency     String?
  fetchedAt    DateTime @default(now())

  @@unique([market, kind, day, dimensionKey, metric], map: "GrowthExternalMetricDaily_key")
  @@index([kind, day])
}

model GrowthIntegrationHealth {
  kind                String
  market              String    @default("EG")
  lastOkAt            DateTime?
  lastErrorAt         DateTime?
  consecutiveFailures Int       @default(0)
  circuit             String    @default("CLOSED") // OPEN CLOSED HALF_OPEN
  updatedAt           DateTime  @updatedAt

  @@id([kind, market])
}

/// Heartbeat of every growth job (one row per run).
model GrowthJobRun {
  id         String    @id @default(cuid())
  job        String
  instanceId String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  rows       Int       @default(0)
