// ── Wave 7 (migrations 20270107090000 .. 20270107095000, owner: lane A1). Additive. See _docs/growth/GROWTH_PHASE2_4_WORK_PACKAGES.md section 7.

/// GRW-P3-A: an experiment. status DRAFT PENDING_APPROVAL RUNNING STOPPED CONCLUDED ARCHIVED. The design is frozen once started (trigger). Never on a safety, consent, price or clinical surface (CHECK and surfaces.ts).
model GrowthExperiment {
  id            String    @id @default(cuid())
  market        String    @default("EG")
  key           String
  name          String
  surface       String
  hypothesis    String
  status        String    @default("DRAFT")
  variants      Json // [{key, weightBp}]
  allocationBp  Int       @default(10000)
  eligibility   Json      @default("{}")
  primaryMetric String
  guardrails    Json      @default("[]")
  mode          String    @default("FIXED") // FIXED SEQUENTIAL
  alphaBp       Int       @default(500)
  minSample     Int       @default(1000)
  plannedDays   Int       @default(14)
  salt          String
  startedAt     DateTime?
  stoppedAt     DateTime?
  stopReason    String?
  createdBy     String
  approvedBy    String?
  flagKey       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  exposures GrowthExperimentExposure[]
  dailies   GrowthExperimentDaily[]
  results   GrowthExperimentResult[]
  events    GrowthExperimentEvent[]

  @@unique([market, key])
  @@index([market, surface, status])
  @@index([status])
}

/// One row per (experiment, unit). unitHash = HMAC(experiment salt, unit key): not linkable to a person. subRef = sha256(sub) only for authenticated units, deleted by growth_erase_experiments.
model GrowthExperimentExposure {
  id           String   @id @default(cuid())
  experimentId String
  market       String   @default("EG")
  day          DateTime @db.Date
  variant      String
  unitKind     String // VISITOR SUB
  unitHash     String
  subRef       String?
  firstAt      DateTime @default(now())

  experiment GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)

  @@unique([experimentId, unitHash])
  @@index([experimentId, day, variant])
  @@index([subRef])
  @@index([firstAt])
}

model GrowthExperimentDaily {
  experimentId    String
  day             DateTime @db.Date
  variant         String
  exposures       Int      @default(0)
  conversions     Int      @default(0)
