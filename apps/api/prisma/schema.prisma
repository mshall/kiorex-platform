  skipped      Int      @default(0)
  ended        Int      @default(0)
  byReason     Json     @default("{}")
  updatedAt    DateTime @default(now()) @updatedAt

  definition LifecycleJourneyDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([definitionId, day])
}

/// GRW-P3-E: an advisory proposal built from AGGREGATES only (k >= 10). Never activates, sends, spends or changes a budget by itself: approval creates a DRAFT for the normal maker-checker path.
