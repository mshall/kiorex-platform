generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── platform: outbox, audit, webhooks ─────────────────────────

model OutboxEvent {
  id            String    @id @default(cuid())
  type          String
  aggregateType String
  aggregateId   String
  target        String    @default("INTERNAL") // INTERNAL | KIORLY | PRODUCT:<product>
  payload       Json
  status        String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  dedupeKey     String?   @unique
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

model WebhookReceipt {
  eventId     String    @id
  source      String    @default("kiorly")
  type        String
  aggregateId String?
  payload     Json
  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

model KvState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── auth sessions (KXM-AC-05) ─────────────────────────

model AuthSession {
  id         String    @id @default(cuid())
  sid        String    @unique
  sub        String
  clientId   String?
  device     String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([sub])
}

// ───────────────────────── patient (KXM-AC-02..07) ─────────────────────────

model PatientProfile {
  id              String    @id @default(cuid())
  sub             String    @unique
  phone           String?
  email           String?
  nameEn          String?
  nameAr          String?
  dateOfBirth     DateTime?
  gender          String?
  nationalIdEnc   String?
  nationalIdHash  String?
  preferredLocale String    @default("ar")
  market          String    @default("EG")
  noShowCount     Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nationalIdHash])
}

model Dependant {
  id           String    @id @default(cuid())
  guardianSub  String
  nameEn       String
  nameAr       String?
  dateOfBirth  DateTime
  gender       String?
  relationship String
  evidence     String?
  expiresAt    DateTime? // age of majority (KA06)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([guardianSub])
}

model ConsentRecord {
  id        String   @id @default(cuid())
  sub       String
  purpose   String // MARKETPLACE_PROCESSING | REMINDERS | RECORD_SHARING | AI_PROCESSING
  granted   Boolean
  version   String   @default("TODO_NEEDS_HUMAN_v0") // textVersion: id of the exact approved wording (AR and EN)
  source    String   @default("app") // web | app | whatsapp | widget | ops-import
  channel   String? // WHATSAPP SMS EMAIL PUSH for the marketing purposes
  ipHash    String? // keyed hash with a daily-rotating salt; never the IP
  evidence  String? // button id
  createdAt DateTime @default(now())

  @@index([sub, purpose, createdAt])
  @@index([purpose, channel, createdAt])
}

model DataRequest {
  id          String    @id @default(cuid())
  sub         String
  kind        String // EXPORT | DELETION
  status      String    @default("REQUESTED") // REQUESTED | COMPLETED
  result      Json?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([sub])
}

model KiorlyPatientLink {
  id              String   @id @default(cuid())
  sub             String
  dependantId     String?
  clinicId        String
  kiorlyPatientId String
  evidence        String // PHONE | NATIONAL_ID | PHONE_AND_NATIONAL_ID
  status          String   @default("LINKED") // LINKED | CONFLICT_REVIEW | STALE (clinic answered 404: patient unknown there)
  createdAt       DateTime @default(now())

  @@unique([sub, clinicId, kiorlyPatientId])
  @@index([sub])
}

// ───────────────────────── catalog (KXM-DS, KXM-PR) ─────────────────────────

model Provider {
  id                   String    @id // Kiorly listingId
  tenantId             String? // Kiorly org (org-scope flags)
  clinicId             String
  clinicianId          String
  status               String // LIVE | PAUSED | ...
  sourceVersion        String // Kiorly updatedAt (ISO)
  market               String    @default("EG")
  nameEn               String?
  nameAr               String?
  clinicNameEn         String?
  clinicNameAr         String?
  specialty            String?
  subSpecialties       String[]
  languages            String[]
  gender               String?
  governorate          String?
  area                 String?
  latitude             Float?
  longitude            Float?
  minFeeMinor          Int?
  maxFeeMinor          Int?
  currency             String    @default("EGP")
  acceptsDeposit       Boolean   @default(false)
  ratingAvg            Float     @default(0)
  ratingCount          Int       @default(0)
  searchText           String    @default("")
  raw                  Json
  syncedAt             DateTime  @default(now())
  createdAt            DateTime  @default(now())
  // Rev 2.3 projections (KX-09 §03): profession, home-visit capability, coverage DISTRICTS only (never a provider home address, KXMDS05)
  profession           String? // PHYSICIAN | DENTIST | PHYSIOTHERAPIST | NURSE (null = legacy doctor)
  edition              String? // CLINIC | NURSE
  careType             String    @default("DOCTORS") // DOCTORS | PHYSIOTHERAPY | HOME_NURSING (derived from profession)
  serviceLocations     String[]  @default([]) // IN_CLINIC | HOME
  coverageDistricts    String[]  @default([])
  assignsClinician     Boolean   @default(false) // agencies: clinician assigned after booking (HOME_VISIT_ASSIGNED)
  verificationRegister String?
  homeSurchargeMinor   Int? // home surcharge (BR56) of the cheapest home fee; outside S and C
  // Search "earliest" index: the start of the provider's next in-clinic slot (7-day horizon), refreshed lazily + by a warmer. NULL = no slot / never indexed.
  nextSlotAt           DateTime?
  slotIndexedAt        DateTime?

  @@index([status, nextSlotAt])
  @@index([careType, status])
  @@index([status, specialty])
  @@index([clinicId, clinicianId])
}

model ProfileViewDaily {
  providerId String
  date       DateTime  @db.Date
  views      Int       @default(0)
  pushedAt   DateTime?

  @@id([providerId, date])
}

model AnalyticsEvent {
  id              String   @id @default(cuid())
  name            String
  specialtyCode   String?
  providerId      String?
  market          String   @default("EG")
  code            String?
  /// Rev 2.3 analytics rule: location is DISTRICT level only (never an address, coordinates or free text).
  district        String?
  careType        String?
  serviceLocation String?
  createdAt       DateTime @default(now())

  @@index([name, createdAt])
}

// ───────────────────────── booking (KXM-BK) ─────────────────────────

model BookingIntent {
  id                    String    @id // kx_bk_<id>; also Kiorly Idempotency-Key / externalReference
  sub                   String
  dependantId           String?
  providerId            String
  clinicId              String
  clinicianId           String
  tenantId              String?
  typeId                String
  startsAt              DateTime
  endsAt                DateTime
  status                String // INTENT HELD PENDING_CLINIC CONFIRMED CHECKED_IN COMPLETED NO_SHOW CANCELLED EXPIRED
  channel               String    @default("MARKETPLACE")
  holdId                String?
  holdExternalRef       String?
  holdExpiresAt         DateTime?
  callState             String    @default("NONE") // NONE | IN_FLIGHT | UNCERTAIN
  kiorlyAppointmentId   String?
  kiorlyPatientId       String?
  kiorlyVersion         Int       @default(0)
  confirmationDueAt     DateTime?
  cancelledBy           String?
  cancellationReason    String?
  depositRefundable     Boolean?
  failureCode           String?
  depositStatus         String    @default("NONE") // NONE REQUIRED PAID REFUNDED FORFEITED RELEASED
  depositAmountMinor    Int       @default(0)
  currency              String    @default("EGP")
  feeMinor              Int?
  patientSnapshot       Json?
  version               Int       @default(0) // optimistic lock
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  terminalAt            DateTime?
  // Rev 2.3 home visits (KXMHV). The address itself lives in BookingVisitAddress (encrypted, masked 24 h after the visit); only the DISTRICT is kept here.
  serviceLocation       String    @default("IN_CLINIC") // IN_CLINIC | HOME
  careType              String    @default("DOCTORS")
  visitDistrict         String?
  homeState             String? // ASSIGNED | EN_ROUTE | ARRIVED | ABORTED_UNSAFE (home sub-states; the main status stays in the KX-03 §05 machine)
  homeSurchargeMinor    Int       @default(0)
  assignee              Json? // {displayName, photoUrl, badge, profession} from HOME_VISIT_ASSIGNED; never a phone number
  enRouteAt             DateTime?
  etaMinutes            Int?
  arrivedAt             DateTime?
  abortedAt             DateTime?
  carePlanId            String?
  telehealth            Json? // Clinic-owned video visit (P2P WebRTC): {sessionId, joinUrl, opensAt, closesAt, state, movedFrom}; see src/booking/telehealth.ts. Kiorex mints nothing.
  // Growth engine (GRW-P1-B0, additive and nullable): commission-relevant origin decided by the attribution function; null = decided before the engine existed or flag OFF (treated as UNATTRIBUTED).
  acquisitionOrigin     String? // PROVIDER_LED | MARKETPLACE | UNATTRIBUTED
  attributionDecisionId String? // GrowthAttributionDecision.id

  events BookingEvent[]

  @@index([sub, status])
  @@index([status, updatedAt])
  @@index([kiorlyAppointmentId])
  @@index([serviceLocation, status])
  @@index([carePlanId])
}

model BookingEvent {
  id         String        @id @default(cuid())
  bookingId  String
  booking    BookingIntent @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind       String // INTENT | HOLD | KIORLY_CALL | WEBHOOK | PAYMENT | STATE | RECONCILE
  fromStatus String?
  toStatus   String?
  detail     Json?
  createdAt  DateTime      @default(now())

  @@index([bookingId, createdAt])
}

// ───────────────────────── Kiorex Pay (KXM-PAY) ─────────────────────────

model PaymentIntent {
  id              String    @id // pay_<id>; used as Kiorly paymentRef
  bookingId       String?
  payLinkToken    String?
  sub             String?
  clinicId        String
  amountMinor     Int
  currency        String    @default("EGP")
  psp             String
  pspRef          String?   @unique
  checkoutUrl     String?
  status          String    @default("CREATED") // CREATED | CAPTURED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  refundedMinor   Int       @default(0)
  feeMinor        Int       @default(0)
  releasedAt      DateTime? // deposit released to clinic payable (completed / forfeited)
  releaseKind     String? // COMPLETED | FORFEITED
  payoutId        String?
  /// DEPOSIT (Kiorly clinic deposit) | PHARMACY | LAB — vertical orders never reach Kiorly clinic payouts.
  purpose         String    @default("DEPOSIT")
  orderRef        String?
  capturedAt      DateTime?
  kiorlyNotified  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// KXMPAY07: HELD_FOR_REVIEW (unsafe-aborted home visit; never auto-forfeited) | RELEASED_TO_PROVIDER | REFUNDED_TO_PATIENT
  reviewState     String?
  reviewReason    String?
  heldForReviewAt DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  /// GRW-P2-B2 (migration 20261217090000): credit applied to this deposit. `amountMinor` stays the CARD amount charged at the PSP; `rewardMinor` is the part paid with credit,
  /// `rewardPostedMinor` the part of it that sits in the Pay ledger HELD account (patient-refund credit always, promotional credit only when REWARD_RULES.postToPayLedger).
  rewardMinor       Int     @default(0)
  rewardPostedMinor Int     @default(0)
  /// GRW-P2-S (migration 20270107096000): provider-sponsored discount that reduced this deposit (gross deposit = amountMinor + rewardMinor + sponsoredMinor). `sponsoredPostedMinor` is the part in the
  /// Pay ledger HELD account (only when REWARD_RULES.postToPayLedger, H-25); `sponsoredVoidedMinor` the cumulative share voided by refunds (never paid to the patient).
  sponsoredMinor       Int @default(0)
  sponsoredPostedMinor Int @default(0)
  sponsoredVoidedMinor Int @default(0)

  refunds Refund[]

  @@index([bookingId])
  @@index([clinicId, status])
}

model PayLink {
  token           String   @id
  clinicId        String
  externalRef     String?
  amountMinor     Int
  currency        String   @default("EGP")
  status          String   @default("OPEN") // OPEN | PAID | EXPIRED
  expiresAt       DateTime
  paymentIntentId String?
  createdAt       DateTime @default(now())
}

model Refund {
  id             String        @id // rf_<id>
  paymentId      String
  payment        PaymentIntent @relation(fields: [paymentId], references: [id])
  amountMinor    Int
  reason         String
  status         String        @default("REQUESTED") // REQUESTED | SETTLED | FAILED
  idempotencyKey String        @unique
  pspRefundRef   String?
  createdAt      DateTime      @default(now())
  settledAt      DateTime?
}

model LedgerTx {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  kind           String
  bookingId      String?
  paymentId      String?
  clinicId       String?
  memo           String?
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]
}

model LedgerEntry {
  id          String   @id @default(cuid())
  txId        String
  tx          LedgerTx @relation(fields: [txId], references: [id])
  account     String
  debitMinor  Int      @default(0)
  creditMinor Int      @default(0)
  currency    String   @default("EGP")
  createdAt   DateTime @default(now())

  @@index([account])
  @@index([txId])
}

model Payout {
  id          String   @id // po_<id>
  payoutRef   String   @unique
  clinicId    String
  amountMinor Int
  currency    String   @default("EGP")
  status      String   @default("SENT") // SENT | KIORLY_RECORDED
  periodKey   String
  paymentRefs Json
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([clinicId, periodKey])
}

model PspSettlementLine {
  id          String   @id @default(cuid())
  psp         String
  pspRef      String
  kind        String // CAPTURE | REFUND
  amountMinor Int
  feeMinor    Int      @default(0)
  date        DateTime @db.Date
  matched     Boolean  @default(false)

  @@unique([psp, pspRef, kind])
}

model ReconciliationRun {
  id            String   @id @default(cuid())
  kind          String // PSP_DAILY | BOOKING_NIGHTLY
  status        String // OK | DISCREPANCIES
  discrepancies Json
  stats         Json?
  createdAt     DateTime @default(now())
}

// ───────────────────────── engagement (KXM-NT) ─────────────────────────

model Message {
  id           String    @id @default(cuid())
  sub          String
  bookingId    String?
  channel      String // WHATSAPP | SMS | PUSH | EMAIL | INAPP
  templateId   String
  locale       String    @default("ar")
  params       Json?
  status       String    @default("SCHEDULED") // SCHEDULED SENT SKIPPED_CONSENT SKIPPED_OPTOUT FAILED CANCELLED
  reason       String?
  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  readAt       DateTime?
  dedupeKey    String?   @unique
  createdAt    DateTime  @default(now())

  @@index([sub, createdAt])
  @@index([status, scheduledFor])
}

/// KXM-NT push device registry: one row per installed app instance (FCM/APNs/web-push token). Tokens are secrets: never logged (masked as push:****).
model DeviceToken {
  id         String    @id // kx_dev_<id>
  sub        String
  platform   String // IOS | ANDROID | WEB
  token      String    @unique
  appVersion String?
  locale     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([sub, revokedAt])
}

model NotificationPreference {
  sub        String
  channel    String
  enabled    Boolean @default(true)
  quietStart Int? // local hour 0-23
  quietEnd   Int?

  @@id([sub, channel])
}

// ───────────────────────── trust (KXM-RV) ─────────────────────────

model Review {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  sub                 String
  providerId          String
  clinicId            String
  clinicianId         String
  kiorlyAppointmentId String
  rating              Int
  text                String?
  status              String   @default("VISIBLE") // VISIBLE | HIDDEN
  moderationFlags     Json?
  clinicReply         String?
  editableUntil       DateTime
  syncStatus          String   @default("PENDING") // PENDING | SYNCED | REJECTED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([providerId, status])
}

model ModerationCase {
  id         String    @id @default(cuid())
  reviewId   String
  reason     String
  status     String    @default("OPEN") // OPEN | RESOLVED
  resolution String? // KEPT_HIDDEN | RESTORED
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

model Complaint {
  id         String    @id @default(cuid())
  sub        String
  bookingId  String?
  category   String
  body       String
  status     String    @default("OPEN")
  slaDueAt   DateTime
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  /// KXMOP05: home-visit complaints carry a 1 h SLA.
  homeVisit  Boolean   @default(false)
}

// ───────────────────────── control plane (KXM-OP-07..11) ─────────────────────────

model FlagDefinition {
  key          String   @id
  product      String
  class        String // MODULE | COMMERCIAL | INTEGRATION | AI | LAUNCH_LOCKED
  scopes       String[] // GLOBAL | MARKET | ORG
  dependsOn    String[]
  launchLocked Boolean  @default(false)
  moneyPath    Boolean  @default(false)
  description  String
  whenOff      String?
  gateHint     String?
  /// Gate ids that must ALL have human-recorded evidence (e.g. GHV1 + GHV2). Empty = any single evidence row satisfies the lock.
  gateIds      String[] @default([])
  /// NURSE for nurse.* keys (catalogue metadata; evaluated in the Clinic runtime, served in the kiorly-clinic snapshot).
  edition      String?
  createdAt    DateTime @default(now())
}

model FlagValue {
  id        String    @id @default(cuid())
  flagKey   String
  scope     String // GLOBAL | MARKET | ORG
  scopeId   String    @default("")
  value     String // OFF | ON (ON == inherit)
  reason    String?
  ticket    String?
  setBy     String?
  expiresAt DateTime?
  startsAt  DateTime? // scheduled activation
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  @@unique([flagKey, scope, scopeId])
}

model FlagGateEvidence {
  flagKey     String
  gateId      String
  approver    String
  approvedOn  DateTime
  documentUrl String
  recordedBy  String
  createdAt   DateTime @default(now())

  @@id([flagKey, gateId])
}

model FlagChangeRequest {
  id          String    @id @default(cuid())
  flagKey     String
  scope       String
  scopeId     String    @default("")
  value       String
  reason      String
  ticket      String
  expiresAt   DateTime?
  requestedBy String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  emergency   Boolean   @default(false)
  reviewDueAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
}

model FlagAudit {
  id        String    @id @default(cuid())
  flagKey   String
  scope     String
  scopeId   String    @default("")
  oldValue  String?
  newValue  String
  actor     String
  reason    String?
  ticket    String?
  expiresAt DateTime?
  emergency Boolean   @default(false)
  event     String    @default("TOGGLE") // TOGGLE | GATE | EXPIRY | REQUEST | APPROVE | REVIEW
  createdAt DateTime  @default(now())

  @@index([flagKey, createdAt])
}

model ProductRegistration {
  product            String    @id
  keyId              String    @unique
  secretEnc          String
  webhookUrl         String?
  webhookSecretEnc   String?
  active             Boolean   @default(true)
  lastFetchedVersion Int       @default(0)
  lastFetchedAt      DateTime?
  lastPushedVersion  Int       @default(0)
  lastPushedAt       DateTime?
  lastPushError      String?
}

model ControlState {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @default(now())
}

// ───────────────────────── AI gateway (KX-11) ─────────────────────────

model AiUsage {
  id            String   @id @default(cuid())
  sub           String?
  purpose       String
  provider      String
  promptVersion String
  redactions    Int      @default(0)
  source        String // AI | RULES
  createdAt     DateTime @default(now())

  @@index([sub, createdAt])
}

// ───────────────────────── unified messaging (mock adapters, KX-00 provider rules) ─────────────────────────

/// Every outbound/inbound message of every channel (EMAIL | WHATSAPP | SMS | PUSH). In MODE=mock this IS the dev inbox.
/// `recipient` and `body` are stored only in mock mode (dev inbox); real mode keeps masked recipient and no body.
model MessageLog {
  id              String    @id @default(cuid())
  messageId       String? // engagement Message that produced it
  channel         String
  direction       String    @default("OUT") // OUT | IN
  mode            String    @default("mock")
  sub             String?
  recipient       String?
  recipientMasked String
  templateId      String?
  locale          String    @default("ar")
  body            String?
  status          String    @default("QUEUED") // QUEUED SENT DELIVERED READ FAILED RECEIVED
  providerRef     String?
  error           String?
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?

  @@index([channel, createdAt])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
}

// ───────────────────────── WhatsApp booking channel (KXM-BK-11) ─────────────────────────

model ChannelConversation {
  id            String    @id @default(cuid())
  channel       String    @default("WHATSAPP")
  phone         String
  sub           String?
  state         String    @default("IDLE")
  context       Json?
  locale        String    @default("ar")
  lastInboundAt DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([channel, phone])
}

// ───────────────────────── waitlist (KXM-BK-12) ─────────────────────────

model WaitlistEntry {
  id            String    @id // kx_wl_<id>
  sub           String
  dependantId   String?
  providerId    String
  clinicId      String
  clinicianId   String
  tenantId      String?
  typeId        String
  preferredFrom DateTime?
  preferredTo   DateTime?
  status        String    @default("WAITING") // WAITING OFFERED BOOKED CANCELLED EXPIRED
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  offers WaitlistOffer[]

  @@index([providerId, status])
  @@index([sub, status])
}

model WaitlistOffer {
  id          String        @id // kx_wo_<id>
  entryId     String
  entry       WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sub         String
  providerId  String
  startsAt    DateTime
  endsAt      DateTime
  status      String        @default("OFFERED") // OFFERED ACCEPTED DECLINED EXPIRED
  expiresAt   DateTime
  bookingId   String?
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  @@unique([entryId, startsAt])
  @@index([status, expiresAt])
}

// ───────────────────────── records & continuity (KXM-RC-01..03) ─────────────────────────

/// A record visible in the patient vault. Clinical content is AES-GCM encrypted (payloadEnc) and NEVER logged.
model SharedRecord {
  id              String    @id // kx_rec_<id>
  sub             String
  kind            String // VISIT_SUMMARY | PRESCRIPTION | LAB_RESULT | UPLOAD
  clinicId        String?
  kiorlyPatientId String?
  dependantId     String? // set when the Kiorly patient link belongs to a dependant (guardian vault)
  sourceRef       String? // encounterId / reportId; unique per (sub, kind) for idempotent re-delivery
  sourceEventId   String?
  title           String?
  payloadEnc      String?
  signedAt        DateTime?
  storageKey      String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  sha256          String?
  status          String    @default("ACTIVE") // ACTIVE | REVOKED
  revokedAt       DateTime?
  revokedReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([sub, kind, sourceRef])
  @@index([sub, status, createdAt])
  @@index([kiorlyPatientId])
}

/// Per-scope record-share consent as the patient set it in Kiorex (mirrored to Kiorly by outbox).
model RecordShareConsent {
  sub       String
  scope     String // VISIT_SUMMARY | PRESCRIPTIONS | LAB_RESULTS | SHARE_WITH_OTHER_CLINICS
  granted   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@id([sub, scope])
}

model FollowUpReminder {
  id        String   @id // kx_fu_<id>
  sub       String
  recordId  String?
  clinicId  String?
  dueAt     DateTime
  source    String   @default("PATIENT") // DOCTOR | PATIENT
  status    String   @default("SCHEDULED") // SCHEDULED | SENT | CANCELLED
  createdAt DateTime @default(now())

  @@index([sub, status, dueAt])
}

// ───────────────────────── Phase-2/3 verticals (KX-03 §08; launch-locked) ─────────────────────────

model PharmacyCart {
  id                   String   @id @default(cuid())
  sub                  String   @unique
  pharmacyId           String?
  /// PartnerRegistration that owns `pharmacyId` (routing: every outbound call of this cart goes there). NULL = legacy/env default.
  registrationId       String?
  items                Json // [{ sku, name, qty, unitPriceMinor, rxRequired }]
  deliveryMethod       String? // PICKUP | DELIVERY
  deliveryAddress      Json?
  prescriptionRecordId String?
  updatedAt            DateTime @updatedAt
}

model PharmacyOrder {
  id                   String    @id // kx_ph_<id>; also the Idempotency-Key towards Kiorly Pharmacy
  sub                  String
  pharmacyId           String
  /// PartnerRegistration that owns the pharmacy: quote, order, Rx validation and cancel go to this registration only; its webhooks are the only ones accepted for the order.
  registrationId       String?
  status               String // PENDING_PAYMENT PAID SUBMITTED READY OUT_FOR_DELIVERY DISPENSED PARTIALLY_FULFILLED PARTIAL_REVIEW REJECTED CANCELLED
  items                Json
  subtotalMinor        Int
  deliveryFeeMinor     Int       @default(0)
  totalMinor           Int
  currency             String    @default("EGP")
  deliveryMethod       String
  deliveryAddress      Json?
  prescriptionRecordId String?
  rxStatus             String    @default("NOT_REQUIRED") // NOT_REQUIRED PENDING VALID INVALID
  partnerOrderId       String?
  paymentId            String?
  takeRateBps          Int       @default(0)
  platformFeeMinor     Int       @default(0)
  rejectionReason      String?
  readyAt              DateTime?
  /// 1.8.0: set when the pharmacy hands a DELIVERY order to the courier (OrderOutForDelivery).
  outForDeliveryAt     DateTime?
  dispensedAt          DateTime?
  /// Itemised partial-fulfilment settlement (policy pharmacy.partial_fulfilment): refunded lines, delivery fee, amounts released, policy snapshot. Null otherwise.
  settlement           Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([sub, status])
  @@index([partnerOrderId])
  @@index([registrationId])
}

model LabBooking {
  id                 String   @id // kx_lb_<id>
  sub                String
  labId              String
  /// PartnerRegistration that owns the lab (slots, quote, order, cancel; only its webhooks apply). NULL = legacy/env default.
  registrationId     String?
  tests              Json // [{ code, name, priceMinor }]
  collectionType     String // HOME | WALK_IN
  slotStartsAt       DateTime
  slotEndsAt         DateTime
  address            Json?
  status             String // PENDING_PAYMENT PAID SUBMITTED COLLECTED RESULT_RELEASED REJECTED CANCELLED
  subtotalMinor      Int
  collectionFeeMinor Int      @default(0)
  totalMinor         Int
  currency           String   @default("EGP")
  paymentId          String?
  partnerOrderId     String?
  takeRateBps        Int      @default(0)
  platformFeeMinor   Int      @default(0)
  rejectionReason    String?
  resultRecordId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sub, status])
  @@index([partnerOrderId])
  @@index([registrationId])
}

model TeleSession {
  id                String    @id // kx_ts_<id>
  sub               String
  bookingId         String    @unique
  providerId        String
  clinicId          String
  status            String    @default("SCHEDULED") // SCHEDULED WAITING IN_PROGRESS ENDED CANCELLED
  videoProvider     String    @default("mock")
  roomName          String
  scheduledStartsAt DateTime
  patientJoinedAt   DateTime?
  clinicianJoinedAt DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSec       Int?
  consultFeeMinor   Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sub, status])
}

/// Vertical partner (Kiorly Pharmacy / Kiorly Lab) registration: base URL host, HMAC client credentials and the per-partner webhook
/// secret (kiorex-contracts 1.4.0). Secrets are AES-GCM encrypted (FIELD_ENCRYPTION_KEY). Dev defaults are seeded; env is the fallback.
model PartnerRegistration {
  id                String   @id // e.g. pr_pharmacy_dev
  kind              String // PHARMACY | LAB | LAB_NURSE (second Lab registration with the KIORLY_NURSE client source, KNLAB01)
  name              String
  baseUrl           String // host only; the contract path prefix is appended (PARTNER_API_PATH)
  clientKey         String   @unique
  clientSecretEnc   String
  webhookSecretEnc  String
  active            Boolean  @default(true)
  /// LAB_NURSE only: the LAB registration (same lab tenant) this nurse client belongs to; routes a Nurse lab order to the lab that owns it.
  labRegistrationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kind, active])
}

// ───────────────────────── Rev 2.3 home visits (KXMHV01-10, KXMPAY07, KXMOP12) ─────────────────────────

/// KXMHV01: patient address book. Street/building/floor/flat/landmark/pin are AES-GCM encrypted (addressEnc, FIELD_ENCRYPTION_KEY);
/// governorate + district stay plain (district-level data is allowed in coverage checks and analytics). NEVER on the provider projection, NEVER logged.
model PatientAddress {
  id                  String    @id // kx_ad_<id>
  sub                 String
  label               String
  governorate         String
  district            String
  addressEnc          String
  confirmedAt         DateTime? // confirmed with the OTP-verified phone before the first home booking
  confirmedPhoneLast4 String?
  isDefault           Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([sub, deletedAt])
}

/// KXMHV03/10: the address snapshot a home booking was made with (so later address-book edits never change a booking).
/// Wiped (addressEnc = null, maskedAt set) 24 h after the visit ended (mirrors Kiorly HV-PRV-01); district stays.
model BookingVisitAddress {
  bookingId   String    @id
  sub         String
  governorate String?
  district    String
  addressEnc  String?
  maskAfter   DateTime? // set when the booking reaches a terminal state: terminalAt + 24 h
  maskedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([maskAfter, maskedAt])
}

/// KXMOP12: SAFETY_ALERT_RAISED feed with the 60 s delivery SLO (KX-09 §08). Free text never appears here (the event has none).
model SafetyAlert {
  id                   String    @id // kx_sa_<id>
  alertId              String    @unique // Kiorly alert id (semantic de-duplication; eventId de-duplication is separate)
  eventId              String?
  bookingId            String?
  clinicId             String
  appointmentId        String?
  kind                 String // TIMER_EXPIRED | SOS | UNSAFE_ABORT
  district             String?
  deliverTo            String[]
  raisedAt             DateTime
  receivedAt           DateTime  @default(now())
  deliverWithinSeconds Int       @default(60)
  deliveredAt          DateTime?
  deliveryMode         String? // mock | real
  deliveryRef          String?
  deliveryError        String?
  status               String    @default("RAISED") // RAISED | ACKNOWLEDGED | ESCALATED | RESOLVED
  acknowledgedAt       DateTime?
  acknowledgedBy       String?
  escalatedAt          DateTime?
  escalatedBy          String?
  escalationLevel      Int       @default(0)
  resolvedAt           DateTime?
  resolvedBy           String?
  createdAt            DateTime  @default(now())

  actions SafetyAlertAction[]

  @@index([status, raisedAt])
  @@index([bookingId])
}

model SafetyAlertAction {
  id        String      @id @default(cuid())
  alertId   String
  alert     SafetyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  action    String // RECEIVED | DELIVERED | DELIVERY_FAILED | ACKNOWLEDGE | ESCALATE | AUTO_ESCALATE | RESOLVE
  actor     String
  note      String?
  createdAt DateTime    @default(now())

  @@index([alertId, createdAt])
}

/// KXMHV07 / BR59: visit-status share with up to 3 family contacts by WhatsApp link. Phone encrypted; the public link token is stored hashed.
model FamilyShare {
  id                String    @id // kx_fs_<id>
  bookingId         String
  sub               String
  contactName       String
  phoneEnc          String
  phoneMasked       String
  phoneHash         String
  tokenHash         String    @unique
  consentAttestedAt DateTime
  status            String    @default("ACTIVE") // ACTIVE | STOPPED | REVOKED
  stoppedAt         DateTime?
  locale            String    @default("ar")
  lastNotifiedState String?
  createdAt         DateTime  @default(now())

  @@unique([bookingId, phoneHash])
  @@index([bookingId, status])
}

/// KXMHV08 (P3, draft, behind nurse.care_plans / GKN1): a care plan booked from Kiorex = one booking with a schedule; each visit is a BookingIntent (carePlanId).
model CarePlanBooking {
  id                 String    @id // kx_cp_<id>; also the Kiorly requestRef
  sub                String
  providerId         String
  clinicId           String
  typeId             String?
  status             String    @default("REQUESTED") // REQUESTED | CONFIRMED | ENDED | REJECTED
  visitDistrict      String?
  visitAddressId     String?
  preferredStartDate DateTime?
  notesEnc           String?
  kiorlyCarePlanId   String?
  endedReason        String?
  confirmedAt        DateTime?
  endedAt            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([sub, status])
}

/// KNLAB01 / KLORD05: relay of a Nurse-edition `LabOrderPlaced` (Kiorly Clinic) to Kiorly Lab and of the lab's status/result back to the clinic.
/// `id` is the Kiorly ClinicalOrder id (LabOrderPlaced.orderId = the lab's sourceRef). Demographics, identifiers and tube labels are relayed, never stored here.
model NurseLabRelay {
  id             String   @id
  clinicId       String
  patientRef     String
  partnerOrderId String?
  /// the LAB_NURSE registration that owns this order (custody / status calls go to it); null = env default
  registrationId String?
  labOrderNumber String?
  /// SUBMITTED | REFUSED | CANCELLED | RESULT_RELEASED
  status         String
  lastLabStatus  String?
  refusalCode    String?
  reportId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([partnerOrderId])
  @@index([clinicId])
}

// ───────────────────── organization onboarding / data import (ops console) ─────────────────────
// Quarantined staging only: nothing here is ever a live clinical table. Rows hold PHI -> never logged, ops/super_admin only.

model ImportBatch {
  id           String             @id @default(cuid())
  orgId        String // target Kiorly Clinic organization id
  orgName      String
  label        String?
  status       String             @default("DRAFT") // DRAFT|NEEDS_REVIEW|READY|AWAITING_APPROVAL|APPROVED|COMMITTING|COMMIT_FAILED|COMMITTED|ROLLING_BACK|ROLLED_BACK
  createdBy    String
  requestedBy  String?
  requestedAt  DateTime?
  reportHash   String? // sha256 of the dry-run report the approver signed off
  approvedBy   String?
  approvedAt   DateTime?
  summary      Json? // last analysis: classification, mappings, stats (no row data)
  progress     Json? // per-entity committed counts, last error code
  committedAt  DateTime?
  rolledBackAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  files        ImportFile[]
  decisions    ImportDecision[]
  tasks        ImportTask[]
  items        ImportCommitItem[]

  @@index([status])
  @@index([orgId])
}

model ImportFile {
  id           String      @id @default(cuid())
  batchId      String
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name         String
  kind         String // SQL|CSV|XLSX|PATIENT_FILE|REJECTED
  rejectReason String?
  sha256       String
  size         Int
  sniffed      String?
  storageKey   String?
  tables       Json? // parsed tabular content (staging copy)
  meta         Json? // dialect, statements, skipped counters, encoding
  createdAt    DateTime    @default(now())

  @@index([batchId])
}

model ImportDecision {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  taskKey   String
  action    String
  params    Json?
  reason    String?
  decidedBy String
  createdAt DateTime    @default(now())

  @@unique([batchId, taskKey])
}

model ImportTask {
  id         String      @id @default(cuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  key        String
  type       String
  severity   String
  entity     String?
  status     String // OPEN|RESOLVED|IGNORED
  payload    Json // full task (context, suggestion, actions, resolution)
  resolvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([batchId, key])
  @@index([batchId, status, severity])
}

model ImportCommitItem {
  id             String      @id @default(cuid())
  batchId        String
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entity         String
  sourceKey      String
  targetId       String
  idempotencyKey String      @unique
  status         String      @default("COMMITTED") // COMMITTED|ROLLED_BACK
  createdAt      DateTime    @default(now())

  @@index([batchId, entity])
}

/// Ops-editable business policy overrides (PolicyService). The in-code value is the PROPOSED_DEFAULT delegated by the founder on 23 Nov 2026;
/// a row overrides it at GLOBAL (scopeId ''), MARKET (ISO country) or ORG (partner / clinic organisation id) scope. Changes are audited.
model PolicySetting {
  id        String   @id @default(cuid())
  key       String
  scope     String // GLOBAL | MARKET | ORG
  scopeId   String   @default("")
  value     Json
  note      String?
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, scope, scopeId])
}

// ───────────────────────── Partner onboarding (connect a standalone organisation, ADR-040) ─────────────────────────

/// A standalone Kiorly organisation (Clinic, Nurse, Pharmacy, Lab) asking to join the Kiorex marketplace. PHI-free by construction:
/// `readiness` holds counts and booleans only, never names of patients or documents. `secretsEnc` is wiped once the PartnerRegistry holds the credentials.
model PartnerConnection {
  id                String    @id // pc_<id>
  kind              String // CLINIC | NURSE | PHARMACY | LAB
  orgRef            String // the partner product's own organisation id
  name              String
  nameAr            String?
  market            String    @default("EG")
  contactEmail      String?
  baseUrl           String? // PHARMACY | LAB: host of the partner API
  clientKey         String?
  secretsEnc        String? // AES-GCM {clientSecret, webhookSecret}; deleted once registered
  pendingSecretsEnc String? // credential rotation awaiting handshake + ops apply
  intakeKeyHash     String? // hex sha256 of the issued intake key (signs later intake requests); the key itself is shown once
  statusTokenHash   String
  status            String    @default("SUBMITTED") // SUBMITTED | IN_REVIEW | CHANGES_REQUESTED | AWAITING_APPROVAL | APPROVED | LIVE | PAUSED | REJECTED
  readiness         Json      @default("{}")
  checks            Json      @default("{}")
  human             Json      @default("{}")
  registrationId    String?
  decisionReason    String?
  requestedBy       String? // asked for approval (two-person rule: approver must differ)
  approvedBy        String?
  approvedAt        DateTime?
  liveAt            DateTime?
  checksRunAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([kind, orgRef])
  @@index([status])
}

/// One-time enrolment code per partner (contracts 1.9.0): created by ops, shown once, signs the FIRST intake request. Only the derived signing key is stored.
model PartnerEnrolment {
  id           String    @id // kxe_<id> (the public part of the code)
  kind         String // CLINIC | NURSE | PHARMACY | LAB
  orgRef       String? // optional: bind the code to one partner organisation
  label        String // who it is for (ops note, no PHI)
  signingKey   String // hex sha256 of the full code
  status       String    @default("ACTIVE") // ACTIVE | USED | REVOKED (EXPIRED is derived from expiresAt)
  expiresAt    DateTime
  createdBy    String
  revokedBy    String?
  revokedAt    DateTime?
  usedAt       DateTime?
  connectionId String?
  createdAt    DateTime  @default(now())

  @@index([status, expiresAt])
}

/// Shared rate-limit counters (PgRateLimiter): one row per (key|windowMs, aligned window). Expired rows are swept by a job.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

/// Replay protection for the partner intake: one row per accepted nonce (id = sha256(kind|orgRef|nonce)); swept after an hour.
model PartnerIntakeNonce {
  id     String   @id
  seenAt DateTime @default(now())

  @@index([seenAt])
}

/// Partner lead (ADR-040 front door): an organisation that asked Kiorex to talk to it from the "Reach more patients" page. Contact details only, never PHI.
model PartnerLead {
  id            String   @id // pl_<id>
  kind          String // CLINIC | NURSE | PHARMACY | LAB
  orgRef        String // the partner product's own organisation id
  orgName       String
  contactName   String
  contactRole   String?
  phone         String?
  email         String?
  preferredTime String? // MORNING | AFTERNOON | EVENING | ANYTIME
  note          String?
  locale        String   @default("en")
  market        String   @default("EG")
  consentAt     DateTime
  status        String   @default("NEW") // NEW | CONTACTED | STARTED | SUBMITTED | LIVE | CLOSED
  assignee      String?
  notes         Json     @default("[]") // [{ at, by, text }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([kind, orgRef])
  @@index([status, createdAt])
}

/// Privacy-safe funnel marker: one row per (kind, org, stage), sent by the partner products (org id + kind only). INTERESTED | STARTED (SUBMITTED and LIVE are read from PartnerConnection).
model PartnerFunnelMark {
  kind    String
  orgRef  String
  stage   String
  firstAt DateTime @default(now())

  @@id([kind, orgRef, stage])
  @@index([stage, firstAt])
}

// ───────────────────────── lead alerts (ops team is told when a partner lead arrives) ─────────────────────────

/// Kiorex team member seen on the ops console (Passport identity). Contact details come from the verified token claims; `leadAlerts`/`channels`
/// are the person's own opt-in for "new partner lead" alerts; `leadsSeenAt` drives the unread badge on the ops nav.
model OpsStaffContact {
  sub         String    @id
  name        String?
  phone       String?
  email       String?
  roles       String[]
  locale      String    @default("en")
  leadAlerts  Boolean   @default(true)
  channels    String[]  @default(["EMAIL", "WHATSAPP", "PUSH"])
  leadsSeenAt DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

/// Singleton ("global"): the ops switch for lead alerts and which channels may be used at all.
model LeadAlertConfig {
  id        String   @id @default("global")
  enabled   Boolean  @default(true)
  channels  String[] @default(["EMAIL", "WHATSAPP", "PUSH"])
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// One alert to one person on one channel for one lead event. `dedupeKey` makes a repeat submission or a retry a no-op.
model LeadAlertDelivery {
  id           String    @id // la_<id>
  dedupeKey    String    @unique
  leadId       String
  staffSub     String
  channel      String
  status       String // SCHEDULED | SENT | SKIPPED | FAILED
  reason       String?
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, scheduledFor])
  @@index([leadId])
}

// ───────────────────────── growth engine (GRW-P1-B0, ARCH sections 6, 7, 16) ─────────────────────────
// Every table carries `market` (ISO alpha-2, default EG: one live market; the API stays multi-market). GrowthTouchpoint and
// GrowthAttributionDecision are append-only (DB triggers, see migration 20261128100000_growth_core). All values below marked
// PROPOSED_DEFAULT in the work-package doc stay configuration, never code branches on a country.

/// Stable source label (sourceKind, sourceRef), e.g. PROVIDER_LINK:<code>, ORGANIC_SEARCH:google, DIRECT. Taxonomy is config.
model GrowthAcquisitionSource {
  id                String    @id @default(cuid())
  market            String    @default("EG")
  sourceKind        String // PROVIDER_LINK PROVIDER_QR WIDGET ORGANIC_SEARCH DIRECT REFERRAL CAMPAIGN WHATSAPP OFFLINE
  sourceRef         String    @default("")
  label             String?
  ownerOrgRef       String? // provider-owned sources: the organisation that owns the link code (from the Clinic projection)
  active            Boolean   @default(true)
  /// Link registry (contracts 1.11.0): state of a PROVIDER_LINK code as the Clinic reports it (ReferralLinkCreated / ReferralLinkRevoked events, signed lookup). ACTIVE | PAUSED | REVOKED.
  linkStatus        String    @default("ACTIVE")
  linkRevokedAt     DateTime?
  registryCheckedAt DateTime? // last time the Clinic confirmed the state through the signed lookup or the reconciliation feed
  createdAt         DateTime  @default(now())
  /// GRW-P4-B2 (migration 20270107094000): which partner product owns the code. CLINIC | PHARMACY | LAB | NURSE.
  product           String    @default("CLINIC")

  touchpoints GrowthTouchpoint[]

  @@unique([market, sourceKind, sourceRef])
  @@index([ownerOrgRef])
}

/// Append-only observation. No IP (keyed hash with daily-rotating salt, blanked after 24 h by growth_purge_expired), no full UA, no full referrer.
model GrowthTouchpoint {
  id             String   @id @default(cuid())
  market         String   @default("EG")
  visitorKey     String? // only after analytics consent (cookie kxv)
  sub            String? // Passport sub, linked to earlier touches only with consent
  sourceId       String
  kind           String // mirrors GrowthAcquisitionSource.sourceKind at touch time
  providerOrgRef String? // provider-owned touches only
  linkCode       String?
  utmSource      String?  @db.VarChar(64)
  utmMedium      String?  @db.VarChar(64)
  utmCampaign    String?  @db.VarChar(64)
  utmContent     String?  @db.VarChar(64)
  utmTerm        String?  @db.VarChar(64)
  clickIdKind    String?
  clickIdHash    String?
  referrerHost   String?  @db.VarChar(255)
  landingKind    String
  localeAt       String   @default("ar")
  dwellMs        Int?
  ltTokenId      String?
  occurredAt     DateTime @default(now())
  ipHash         String   @default("")
  uaClass        String   @default("unknown") // browser family and platform class only

  source GrowthAcquisitionSource @relation(fields: [sourceId], references: [id])

  @@index([visitorKey, occurredAt])
  @@index([sub, occurredAt])
  @@index([providerOrgRef, occurredAt])
  @@index([market, occurredAt])
  @@index([sourceId])
}

/// Append-only. One decision per booking and policy version (unique). Corrections insert a new row with supersedesId; old rows stay. Holds no personal data.
model GrowthAttributionDecision {
  id                   String   @id @default(cuid())
  market               String   @default("EG")
  bookingId            String
  origin               String // PROVIDER_LED | MARKETPLACE | UNATTRIBUTED
  reasonCode           String
  policyVersionId      String
  inputsHash           String
  evidenceTouchIds     String[]
  firstTouchId         String?
  lastTouchId          String?
  lastNonDirectTouchId String?
  winningTouchId       String? // the touch that decided the origin (null for channel-only and no-evidence decisions)
  bookingSnapshot      Json? // booking subset the function saw (ids, createdAt, channel, hasValidLt, precedence): enough to replay; no personal data
  supersedesId         String?
  actor                String? // set only on a correction (a human or system actor)
  note                 String? // correction reason; never patient data
  createdAt            DateTime @default(now())

  policyVersion GrowthConfigVersion @relation(fields: [policyVersionId], references: [id])

  // unique (bookingId, policyVersionId) WHERE supersedesId IS NULL and unique (supersedesId) WHERE NOT NULL: partial indexes in migration 20261128120000
  @@index([bookingId, policyVersionId])
  @@index([bookingId])
  @@index([market, createdAt])
  @@index([supersedesId])
}

/// Canonical funnel event (names in @kiorex/contracts GROWTH_EVENT_NAMES). props is allow-listed and PHI-guarded by the service; specialty and provider ids never land here.
model GrowthEvent {
  id         String   @id @default(cuid())
  market     String   @default("EG")
  name       String
  visitorKey String?
  bookingId  String?
  careType   String?
  props      Json     @default("{}")
  dedupeKey  String?  @unique // same fact from web, mobile, messaging or backend = same key (idempotent ingestion)
  occurredAt DateTime @default(now())

  @@index([name, occurredAt])
  @@index([market, occurredAt])
  @@index([visitorKey])
  @@index([bookingId])
}

/// Daily rollup by dimensions (k-anonymity is applied at read). Unique on the full dimension key so the rollup job is idempotent. Dimension columns use '' for "not applicable".
model GrowthMetricDaily {
  id          String   @id @default(cuid())
  market      String   @default("EG")
  day         DateTime @db.Date
  metric      String
  sourceKind  String   @default("")
  landingKind String   @default("")
  careType    String   @default("")
  origin      String   @default("")
  // GRW-P1-J dimensions ('' = not applicable). Visitor-stream metrics (up to ProviderViewed) never carry city/district/specialty/provider/doctor/branch.
  city        String   @default("")
  district    String   @default("")
  specialty   String   @default("")
  providerRef String   @default("") // organisation (tenant) id, a business id, never a patient
  doctorRef   String   @default("")
  branchRef   String   @default("")
  campaign    String   @default("")
  channel     String   @default("")
  platform    String   @default("")
  product     String   @default("")
  /// GRW-P2-X1: campaign dimension by id ('' = not applicable). The key moved to GrowthMetricDaily_dim2_key (superseding unique index, migration 20261203090000).
  campaignId  String   @default("")
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([market, day, metric, sourceKind, landingKind, careType, origin, city, district, specialty, providerRef, doctorRef, branchRef, campaign, channel, platform, product, campaignId], map: "GrowthMetricDaily_dim2_key")
  @@index([day])
  @@index([metric, day])
}

/// Kiorex revenue facts (GRW-P1-J, KX-32 section 04): one row per commission charge event from the Clinic. Never GBV, never deposits or promotional credits.
model GrowthRevenueFact {
  id            String   @id @default(cuid())
  market        String   @default("EG")
  kind          String // CHARGE | REVERSAL
  chargeId      String
  appointmentId String
  bookingId     String?
  status        String // charge status at the event: PENDING CONFIRMED DISPUTED REVERSED WAIVED BILLED
  amountMinor   Int
  currency      String   @default("EGP")
  origin        String   @default("")
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  @@unique([kind, chargeId, status])
  @@index([occurredAt])
  @@index([bookingId])
}

/// Marketing spend entered by hand (maker-checker; GRW-P1-J). Counts only when APPROVED. Later phases fill the same table from campaign budgets and ad-platform adapters.
model GrowthSpendEntry {
  id          String    @id @default(cuid())
  market      String    @default("EG")
  day         DateTime  @db.Date
  campaign    String    @default("")
  channel     String    @default("")
  sourceKind  String    @default("")
  amountMinor Int
  currency    String    @default("EGP")
  note        String    @default("")
  status      String    @default("PENDING") // PENDING APPROVED REJECTED
  createdBy   String
  createdAt   DateTime  @default(now())
  decidedBy   String?
  decidedAt   DateTime?
  /// GRW-P2-X1: the campaign this spend belongs to (null = not campaign spend). source MANUAL | ADAPTER | CAMPAIGN_PLAN; adapterRef is the external row id for ADAPTER (de-duplication key with campaignId, day, source).
  campaignId  String?
  source      String    @default("MANUAL")
  adapterRef  String?

  @@index([day, status])
  @@index([campaignId, day])
}

/// Immutable versioned growth configuration (ARCH section 16). Rows are never edited after leaving DRAFT; rollback = a new version copying an older payload.
/// scopeId is '' for GLOBAL scope so the unique key works. One ACTIVE row per (kind, scope, scopeId): partial unique index in the migration.
model GrowthConfigVersion {
  id            String    @id @default(cuid())
  kind          String // ATTRIBUTION_POLICY SEO WIDGET_POLICY CONSENT_DEFAULTS COMMS_CAPS CAMPAIGN_GUARDRAILS REWARDS INTEGRATIONS EXPERIMENT_GUARDRAILS MARKET_GROWTH
  scope         String    @default("GLOBAL") // GLOBAL | MARKET
  scopeId       String    @default("") // market code for MARKET scope
  version       Int
  status        String    @default("DRAFT") // DRAFT PENDING_APPROVAL APPROVED ACTIVE SUPERSEDED REJECTED ROLLED_BACK WITHDRAWN
  payload       Json
  schemaVersion Int       @default(1)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  ticket        String?
  reason        String?
  checksum      String
  supersedesId  String?
  announcement  String? // provider-facing text, required for ATTRIBUTION_POLICY changes

  decisions GrowthAttributionDecision[]

  @@unique([kind, scope, scopeId, version])
  @@index([kind, scope, scopeId, status])
}

/// Current slug of an entity (lowercase ASCII, identical in AR and EN). Kiorex owns it (a provider renaming their Kiorly link never changes the SEO URL silently).
model GrowthSlug {
  id         String   @id @default(cuid())
  market     String   @default("EG")
  entityType String // DOCTOR CLINIC PHARMACY LAB SPECIALTY CITY DISTRICT
  entityId   String
  slug       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([market, entityType, slug])
  @@unique([market, entityType, entityId])
}

/// Every slug an entity ever had; old slugs answer 301 to the current one. Never deleted while the entity exists.
model GrowthSlugHistory {
  id           String   @id @default(cuid())
  market       String   @default("EG")
  entityType   String
  entityId     String
  slug         String
  replacedBy   String? // the slug that replaced it
  supersededAt DateTime @default(now())

  @@unique([market, entityType, slug])
  @@index([entityType, entityId])
}

/// Generated page descriptor (indexability and guard result). paramsKey is the canonical string of params so the unique key is stable.
model GrowthLandingPage {
  id             String    @id @default(cuid())
  market         String    @default("EG")
  pageType       String // HOME SPECIALTY_CITY SPECIALTY_DISTRICT CARE_TYPE_DISTRICT HUB DOCTOR CLINIC
  locale         String
  paramsKey      String
  params         Json
  indexable      Boolean   @default(false)
  guardResult    Json?
  lastRenderedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([market, pageType, locale, paramsKey])
  @@index([market, indexable])
}

/// Widget origins verified from the Clinic profile projection (PROVIDER_PROFILE_UPDATED.widgetOrigins). Exact https origins only, at most 10 (constraint in the migration).
model WidgetRegistration {
  id        String   @id @default(cuid())
  market    String   @default("EG")
  orgRef    String   @unique
  orgSlug   String?
  origins   String[]
  status    String   @default("ACTIVE") // ACTIVE | DISABLED
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgSlug])
}

model GrowthFraudSignal {
  id           String    @id @default(cuid())
  market       String    @default("EG")
  ruleId       String
  subjectHash  String // keyed hash; never an identifier
  score        Int       @default(0)
  evidenceRef  String?
  createdAt    DateTime  @default(now())
  /// GRW-P1-K review queue: OPEN | CONFIRMED | DISMISSED. A review never changes an attribution decision.
  reviewStatus String    @default("OPEN")
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([ruleId, createdAt])
  @@index([subjectHash])
  @@index([reviewStatus, createdAt])
}

/// GRW-P1-K propagation monitoring: which reader (API/site instance + service) loaded which config version, and when it was last seen on it.
model GrowthConfigReader {
  id            String   @id @default(cuid())
  instanceId    String
  reader        String
  kind          String
  scope         String   @default("GLOBAL")
  scopeId       String   @default("")
  versionId     String
  version       Int
  firstLoadedAt DateTime @default(now())
  loadedAt      DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@unique([instanceId, reader, kind, scope, scopeId], map: "GrowthConfigReader_instance_reader_key")
  @@index([kind, scope, scopeId])
}

/// Anonymous visitor consent audit (banner decisions). Keyed by a random consent id; holds no sub and no cookie value. Append-only (trigger).
model GrowthVisitorConsent {
  id          String   @id // kxc_<random>
  market      String   @default("EG")
  analytics   Boolean
  marketing   Boolean  @default(false)
  textVersion String
  source      String   @default("web")
  evidence    String?
  ipHash      String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Marketing suppression list (STOP / إلغاء, bounces, complaints, withdrawal). addressHash is a keyed hash of phone or email: the raw value is never stored here.
model CommunicationSuppression {
  id          String    @id @default(cuid())
  market      String    @default("EG")
  channel     String // WHATSAPP SMS EMAIL PUSH ALL
  addressHash String
  reason      String // STOP BOUNCE COMPLAINT WITHDRAWAL MANUAL
  source      String    @default("system")
  createdAt   DateTime  @default(now())
  liftedAt    DateTime?

  @@unique([market, channel, addressHash])
  @@index([addressHash])
}

// ═════════════════════════════════════ Growth Phase 2 (GRW-P2-X1, W5; contracts 1.12.0) ═════════════════════════════════════
// One schema owner per wave. Migrations 20261203090000 .. 20261203099000. Every table carries `market` (column default, never a code branch).
// `sub` columns are the Passport subject; hashes are keyed hashes from the growth hash helper. Non-Prisma constraints (CHECKs, partial unique indexes,
// append-only triggers, balance trigger) live in the migrations and are listed by test/growth-p2-schema.int.spec.ts.

/// A campaign PLAN (never an ad-platform object, AD-1). Money fields are minor units. status: DRAFT PENDING_APPROVAL SCHEDULED ACTIVE PAUSED COMPLETED ARCHIVED.
model GrowthCampaign {
  id                  String    @id @default(cuid())
  market              String    @default("EG")
  key                 String
  /// `<market lower case>-<key>`: the value of utm_campaign. Unique per market. Never changes after the campaign was ACTIVE.
  utmCampaign         String
  name                String
  objective           String
  status              String    @default("DRAFT")
  startsAt            DateTime?
  endsAt              DateTime?
  autoExpiresAt       DateTime?
  budgetTotalMinor    Int
  budgetDailyMinor    Int
  currency            String    @default("EGP")
  channels            String[]
  eligibility         Json      @default("{}")
  utmConfig           Json      @default("{}")
  landingPageId       String?
  policyVersionId     String
  ownerSub            String
  /// sha256 of the money-relevant payload the last approval covered; a later edit of those fields clears it (approval invalidated).
  approvedPayloadHash String?
  /// Next day boundary (market timezone) until which a daily-cap pause holds; null for other pauses.
  pausedUntil         DateTime?
  pauseReason         String? // BUDGET | MANUAL | GUARDRAIL
  /// Alert thresholds (basis points of the total budget) already announced: each fires once.
  thresholdsFiredBp   Int[]
  statusReason        String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  activatedAt         DateTime?
  completedAt         DateTime?
  archivedAt          DateTime?

  creatives   GrowthCampaignCreative[]
  approvals   GrowthCampaignApproval[]
  history     GrowthCampaignStatusHistory[]
  budgetDaily GrowthCampaignBudgetDaily[]
  /// GRW-P4-D: the partnership programs this campaign (channel PARTNER) approves.
  partnerships PartnershipProgram[]

  @@unique([market, key])
  @@unique([market, utmCampaign])
  @@index([market, status])
  @@index([status, startsAt])
  @@index([status, endsAt])
}

model GrowthCampaignCreative {
  id         String   @id @default(cuid())
  campaignId String
  kind       String // IMAGE VIDEO COPY LANDING LINK
  assetRef   String // S3 key under growth/creatives/<market>/<campaignId>/ or an https URL on the policy allowlist
  locale     String   @default("ar")
  status     String   @default("DRAFT") // DRAFT APPROVED RETIRED
  checksum   String?
  createdBy  String
  createdAt  DateTime @default(now())

  campaign GrowthCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

/// Maker-checker for ACTIVATE, BUDGET_INCREASE and REACTIVATE. CHECK decidedBy <> requestedBy in the migration. `snapshot` holds the exact reviewed payload and its hash.
model GrowthCampaignApproval {
  id           String    @id @default(cuid())
  campaignId   String
  kind         String // ACTIVATE BUDGET_INCREASE REACTIVATE
  requestedBy  String
  requestedAt  DateTime  @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  decision     String? // APPROVED REJECTED
  reason       String?
  snapshot     Json
  snapshotHash String

  campaign GrowthCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, requestedAt])
  @@index([decision, requestedAt])
}

/// Append-only (trigger): every transition of every campaign.
model GrowthCampaignStatusHistory {
  id         String   @id @default(cuid())
  campaignId String
  from       String
  to         String
  actor      String // ops sub, or system:scheduler / system:budget
  reasonCode String
  at         DateTime @default(now())

  campaign GrowthCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, at])
}

model GrowthCampaignBudgetDaily {
  campaignId         String
  day                DateTime @db.Date
  plannedMinor       Int      @default(0)
  approvedSpendMinor Int      @default(0)
  pendingSpendMinor  Int      @default(0)
  utilisationBp      Int      @default(0)
  updatedAt          DateTime @updatedAt

  campaign GrowthCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, day])
}

/// One referral code per patient and market (8 Crockford base32, CHECK in the migration).
model ReferralCode {
  id        String   @id @default(cuid())
  market    String   @default("EG")
  sub       String
  code      String   @unique
  status    String   @default("ACTIVE") // ACTIVE SUSPENDED
  createdAt DateTime @default(now())

  relationships ReferralRelationship[]

  @@unique([market, sub])
}

model ReferralRelationship {
  id                 String    @id @default(cuid())
  market             String    @default("EG")
  referrerSub        String
  refereeSub         String
  codeId             String
  touchId            String?
  status             String    @default("INVITED") // INVITED SIGNED_UP BOOKED QUALIFIED REJECTED EXPIRED
  rejectReason       String?
  firstBookingId     String?
  qualifiedBookingId String?
  ruleVersionId      String
  createdAt          DateTime  @default(now())
  qualifiedAt        DateTime?
  /// GRW-P2-B1 (migration 20261217090000): end of the hold window after the completed first visit, the review state of a fraud hold, the campaign the invite came through.
  holdUntil          DateTime?
  completedAt        DateTime?
  reviewState        String    @default("NONE") // NONE HOLD RELEASED REJECTED
  campaignId         String?
  claimedVia         String    @default("LINK") // LINK SIGNUP APP

  code   ReferralCode                 @relation(fields: [codeId], references: [id])
  checks ReferralQualificationCheck[]

  @@unique([market, refereeSub])
  @@index([referrerSub, createdAt])
  @@index([status, createdAt])
}

/// Append-only (trigger). detail never holds personal data.
model ReferralQualificationCheck {
  id             String   @id @default(cuid())
  relationshipId String
  checkKey       String
  passed         Boolean
  detail         Json     @default("{}")
  at             DateTime @default(now())

  relationship ReferralRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId, at])
}

/// Keyed hashes of identity signals for duplicate detection (PHONE, PAY_FINGERPRINT, DEVICE, IP24). DEVICE is off by default (REFERRAL_RULES.signals.deviceSignal).
model ReferralIdentitySignal {
  id          String   @id @default(cuid())
  sub         String
  kind        String
  valueHash   String
  firstSeenAt DateTime @default(now())

  @@unique([kind, valueHash, sub])
  @@index([sub])
}

/// A bundle of reward value. `status` is a cache; the truth is RewardLedgerEntry.
model RewardLot {
  id                  String   @id @default(cuid())
  market              String   @default("EG")
  sub                 String
  kind                String // REFERRER REFEREE REPEAT PROMO CORPORATE LOYALTY
  mode                String // CREDIT COUPON
  currency            String   @default("EGP")
  amountMinor         Int
  couponCodeHash      String?
  status              String   @default("ACTIVE") // ACTIVE HELD EXHAUSTED EXPIRED REVERSED
  ruleVersionId       String
  relationshipId      String?
  campaignId          String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  /// Rev 2.6 (migration 20261203096000): who OWNS the credit (family: the owner; `sub` stays the person it was issued for), the household, the funding label, the spend scope, the verified qualifying visit.
  ownerSub            String?
  householdId         String?
  /// PLATFORM_MARKETING | PLATFORM_SERVICE_RECOVERY | PATIENT_REFUND (the patient's own refunded money: never a marketing expense, never revenue)
  funding             String   @default("PLATFORM_MARKETING")
  scope               Json     @default("{}")
  qualifyingBookingId String?
  /// GRW-P2-B2 (migration 20261217090000): the sealed coupon code lives here only until the patient has seen it once; afterwards only `couponCodeHash` stays.
  couponCodeSealed    String?
  couponRevealedAt    DateTime?
  issuedBy            String   @default("system")
  reasonCode          String?

  entries RewardLedgerEntry[]

  @@index([sub, status])
  @@index([expiresAt, status])
  @@index([relationshipId])
  @@index([campaignId])
  @@index([ownerSub])
  @@index([householdId])
}

/// Append-only ledger (trigger reward_ledger_immutable). amountMinor > 0. idempotencyKey unique: a retry can never double an entry.
/// A constraint trigger refuses any entry that would make available, held or reserved negative (FOR UPDATE on the lot row).
model RewardLedgerEntry {
  id             String   @id @default(cuid())
  lotId          String
  type           String // ISSUE HOLD RELEASE_HOLD RESERVE UNRESERVE REDEEM REVERSE EXPIRE
  amountMinor    Int
  currency       String   @default("EGP")
  idempotencyKey String   @unique
  ruleVersionId  String
  bookingId      String?
  payLinkId      String?
  relationshipId String?
  reasonCode     String
  actor          String
  createdAt      DateTime @default(now())
  /// Rev 2.6: the refund a REFUND_CREDIT lot was issued for (the only ISSUE linked to a payment path, safety rule S7).
  refundId       String?

  lot RewardLot @relation(fields: [lotId], references: [id])

  @@index([lotId, createdAt])
  @@index([bookingId])
  @@index([refundId])
}

model RewardIssuanceBudget {
  ruleVersionId String   @id
  issuedMinor   Int      @default(0)
  ceilingMinor  Int
  updatedAt     DateTime @updatedAt
}

/// Non-clinical lifecycle facts per patient (GRW-P2-E). NO specialty, provider, diagnosis or visit-reason column may ever be added: test/growth-p2-schema.int.spec.ts lists the allowed columns.
