  nonceHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  outcome   String? // CONFIRMED DECLINED
  resultRef String?
  createdAt DateTime  @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
