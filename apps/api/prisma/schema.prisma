// ───────────────────────── GRW-P4-A cross-product journeys (wave 8 lane A3) ─────────────────────────

/// Append-only measurement link clinic booking -> downstream fact (pharmacy order, lab booking, care-plan booking) created through a Kiorex continuity entry point.
/// Keyed hashes of the two fact ids, the two decision ids and origins, the lag in hours. NO person, clinic, specialty or clinical content (guard test: cross-product-no-clinical-data).
model CrossProductContinuity {
  id               String   @id @default(cuid())
  market           String   @default("EG")
  fromProduct      String   @default("CLINIC")
  toProduct        String // PHARMACY LAB NURSE
  entryPoint       String // RX_TO_PHARMACY LAB_ORDER_TO_LAB CARE_PLAN_TO_HOME_VISIT
  fromFactRef      String // keyed hash of the clinic booking id (32 hex)
  toFactRef        String // keyed hash of the downstream fact id (32 hex)
  decisionId       String // GrowthProductDecision.id of the downstream fact
  parentDecisionId String? // GrowthAttributionDecision.id of the clinic booking
  parentOrigin     String? // PROVIDER_LED MARKETPLACE UNATTRIBUTED: how the first booking was acquired (a future rate may exempt PROVIDER_LED; no charge exists today)
  toOrigin         String // origin of the downstream decision (CROSS_PRODUCT unless its own evidence was PROVIDER_LED)
  lagHours         Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([toProduct, toFactRef], map: "CrossProductContinuity_to_key")
  @@index([market, toProduct, createdAt], map: "CrossProductContinuity_market_to_createdAt_idx")
}

/// The patient's own in-app prompt state for one continuity card (short lived, erased with the subject). Kind and keyed hash only, never content.
model CrossProductEntryPoint {
  id              String    @id @default(cuid())
  market          String    @default("EG")
  sub             String
  kind            String // RX_TO_PHARMACY LAB_ORDER_TO_LAB CARE_PLAN_TO_HOME_VISIT
  factRef         String // keyed hash of the clinical fact id (encounter id, order id) or of the clinic booking id
  parentBookingId String? // the patient's own clinic booking (BookingIntent.id), resolved by the server
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  dismissedAt     DateTime?

  @@unique([sub, kind, factRef], map: "CrossProductEntryPoint_sub_kind_fact_key")
  @@index([sub, expiresAt], map: "CrossProductEntryPoint_sub_expires_idx")
}

// ── GRW-P4-C corporate partnerships and enterprise acquisition (migration 20270128093000_growth_p4_corporate) ──
// A corporate benefit is its OWN append-only ledger (CorporateBenefitEntry). It never writes RewardLot or RewardLedgerEntry (patient credit) and never touches the Clinic provider credit.
// There is no balance column anywhere: the employer funds a ceiling, a member may use up to a per-member cap against the deposit of a booking, and nothing can be topped up, transferred or cashed out.
// Prices, ceilings, caps and bp are entered per account by ops after a signed contract (NEEDS_HUMAN): null until then, and an account with incomplete terms cannot be activated.

/// A company programme. Company data only: no employee data, no contact person (billingContactRef is an opaque reference to the finance record).
model CorporateAccount {
  id                  String    @id @default(cuid())
  market              String    @default("EG")
  displayName         String
  legalNameRef        String?
  /// LEAD ACTIVE PAUSED ENDED. ACTIVE needs a contractRef, complete terms and a second person (activatedBy differs from termsEditedBy).
  status              String    @default("LEAD")
  contractRef         String?
  /// SPONSOR_CREDIT (employer funds a ceiling) or PLATFORM_PROMO (Kiorex marketing expense; counsel and CFO decide).
  fundingMode         String    @default("SPONSOR_CREDIT")
  billingContactRef   String?
  startsAt            DateTime?
  endsAt              DateTime?
  currency            String    @default("EGP")
  sponsorCeilingMinor Int?
  perMemberCapMinor   Int?
  perVisitMaxMinor    Int?
  /// Share of a booking deposit the benefit may cover, in basis points (1..10000).
  coverBp             Int?
  emailDomains        String[]  @default([])
  termsEditedBy       String?
  termsEditedAt       DateTime?
  activatedBy         String?
  activatedAt         DateTime?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  codes        CorporateCode[]
  members      CorporateMember[]
  hrBatches    CorporateHrBatch[]
  invoiceNotes CorporateInvoiceNote[]

  @@index([market, status])
}

/// A redemption code. The plain code is shown once to the ops user who creates it; only the keyed hash is stored.
model CorporateCode {
  id                String    @id @default(cuid())
  accountId         String
  codeHash          String    @unique
  label             String
  /// OPEN (anyone holding it) or LIST (the redeemer must also be on an approved HR list).
  kind              String    @default("OPEN")
  maxRedemptions    Int
  redeemedCount     Int       @default(0)
  perMemberCapMinor Int?
  expiresAt         DateTime?
  /// ACTIVE REVOKED (EXPIRED and EXHAUSTED are derived from the dates and the counter).
  status            String    @default("ACTIVE")
  createdBy         String
  createdAt         DateTime  @default(now())

  account CorporateAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
}

/// A verified member. The employer receives counts only. `subHash` is a keyed hash (never the Passport sub); one ACTIVE membership per person (partial unique index in the migration).
model CorporateMember {
  id                String    @id @default(cuid())
  accountId         String
  subHash           String
  codeId            String?
  /// DOMAIN_EMAIL HR_LIST CODE
  verifiedBy        String
  enrolledAt        DateTime  @default(now())
  endedAt           DateTime?
  /// LEFT ACCOUNT_ENDED REVOKED ERASED
  endReason         String?
  /// Snapshot of the cap that applied at enrolment (code cap, else account cap). Null = the account cap at the time of use.
  perMemberCapMinor Int?

  account CorporateAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, subHash])
  @@index([accountId, endedAt])
  @@index([subHash])
}

/// The corporate benefit ledger. Append-only; amountMinor > 0; idempotencyKey unique. A trigger refuses any entry that would exceed the account ceiling or the member cap, or release / redeem / reverse more than exists.
/// used = RESERVE - RELEASE - REVERSE. held = RESERVE - RELEASE - REDEEM. redeemed = REDEEM - REVERSE.
model CorporateBenefitEntry {
  id             String   @id @default(cuid())
  accountId      String
  memberId       String
  /// RESERVE REDEEM RELEASE REVERSE
  type           String
  amountMinor    Int
  currency       String   @default("EGP")
  /// The booking the benefit was reserved for. Internal to the ledger: no corporate endpoint, report or export ever selects, joins or returns it (corporate-privacy.int.spec.ts asserts the response shapes).
  bookingId      String
  idempotencyKey String   @unique
  reasonCode     String
  actor          String
  createdAt      DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([memberId])
  @@index([bookingId])
}

/// An uploaded HR list, two-person approved. Rows are keyed hashes of a phone or e-mail and are deleted when the match window ends.
model CorporateHrBatch {
  id           String    @id @default(cuid())
  accountId    String
  /// PENDING_APPROVAL APPROVED REJECTED PURGED
  status       String    @default("PENDING_APPROVAL")
  rowCount     Int
  uploadedBy   String
  approvedBy   String?
  approvedAt   DateTime?
  windowEndsAt DateTime?
  purgedAt     DateTime?
  createdAt    DateTime  @default(now())

  account CorporateAccount   @relation(fields: [accountId], references: [id])
  entries CorporateHrEntry[]

  @@index([accountId, status])
}

model CorporateHrEntry {
  id        String    @id @default(cuid())
  batchId   String
  keyHash   String
  matchedAt DateTime?

  batch CorporateHrBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, keyHash])
  @@index([keyHash])
}

/// An enterprise lead (company data only; a contact is an opaque reference, never a name, phone or e-mail).
model CorporateLead {
  id             String   @id @default(cuid())
  market         String   @default("EG")
  /// B2B_REFERRAL OUTBOUND INBOUND
  source         String
  referrerOrgRef String?
  /// The Clinic's ProviderB2BReferral id: the idempotency key of the ingest.
  referralRef    String?  @unique
  companyName    String
  /// 1_49 50_199 200_999 1000_PLUS UNKNOWN
  sizeBucket     String   @default("UNKNOWN")
  contactRef     String?
  /// NEW CONTACTED QUALIFIED PROPOSAL WON LOST DUPLICATE
  status         String   @default("NEW")
  ownerSub       String?
  notes          String   @default("")
  accountId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  history CorporateLeadHistory[]

  @@index([status, createdAt])
  @@index([source, status])
}

/// Append-only history of a lead (trigger).
model CorporateLeadHistory {
  id         String   @id @default(cuid())
  leadId     String
  fromStatus String?
  toStatus   String
  actor      String
  note       String?
  at         DateTime @default(now())

  lead CorporateLead @relation(fields: [leadId], references: [id])

  @@index([leadId, at])
}

/// Manual invoicing support (no billing engine): the sponsor spend of a month as the ledger showed it when ops wrote the note.
model CorporateInvoiceNote {
  id                String   @id @default(cuid())
  accountId         String
  month             String
  sponsorSpendMinor Int
  notes             String   @default("")
  createdBy         String
  createdAt         DateTime @default(now())

  account CorporateAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, month])
}

// ───────────── GRW-P4-D loyalty points and partnership programs (migration 20270218090000_growth_p4_loyalty) ─────────────
// A SEPARATE points ledger. Points are not money: no cash, top-up, transfer or gift exists. The only way out is a reward lot of kind LOYALTY in the patient reward ledger (RewardLot), written in the same transaction.

/// One per person and market. `pointsBalanceCache` can only be moved by the ledger trigger (loyalty_entry_guard) and can never be negative.
model LoyaltyAccount {
  id                 String    @id
  sub                String
  market             String    @default("EG")
  /// NONE SILVER GOLD PLATINUM (CHECK in the migration)
  tier               String    @default("NONE")
  tierSince          DateTime?
  pointsBalanceCache Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  entries LoyaltyAccrualEntry[]

  @@unique([market, sub])
  @@index([market, tier])
}

/// Append-only (trigger). ACCRUE and TIER_BONUS add points (with `expiresAt`); EXPIRE, REVERSE and CONVERT subtract. points > 0. idempotencyKey unique. A trigger refuses an entry that would make the balance negative.
model LoyaltyAccrualEntry {
  id              String    @id
  accountId       String
  type            String // ACCRUE EXPIRE REVERSE TIER_BONUS CONVERT
  points          Int
  bookingId       String?
  /// CONVERT: the RewardLot of kind LOYALTY the points became (checked by the trigger, no foreign key: the ledgers stay separate)
  lotId           String?
  idempotencyKey  String    @unique
  expiresAt       DateTime?
  /// REVERSE: points that could not be taken back because they were already converted or spent (ops sees the sum).
  shortfallPoints Int       @default(0)
  reasonCode      String
  actor           String
  createdAt       DateTime  @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([bookingId])
  @@index([type, createdAt])
}

/// A time-boxed, budgeted partner offer. Approval goes through the linked GrowthCampaign (channel PARTNER); the budget cap is a database trigger.
model PartnershipProgram {
  id                 String    @id
  market             String    @default("EG")
  key                String
  /// Opaque partner reference (an ops-side label), never a person or a contact.
  partnerRef         String
  kind               String // CODE_DISCOUNT CO_PROMO CARD_OFFER
  rules              Json      @default("{}")
  status             String    @default("DRAFT") // DRAFT ACTIVE PAUSED ENDED
  startsAt           DateTime?
  endsAt             DateTime?
  fundingMode        String    @default("PLATFORM_MARKETING") // PLATFORM_MARKETING PARTNER_FUNDED (the second cannot be activated: NEEDS_HUMAN)
  budgetMinor        Int       @default(0)
  perRedemptionMinor Int       @default(0)
  currency           String    @default("EGP")
  campaignId         String?
  /// Reference of the counsel-approved legal text; a placeholder until counsel supplies it.
  legalTextRef       String?
  createdBy          String
  activatedBy        String?
  activatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  campaign    GrowthCampaign?             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  codes       PartnershipCode[]
  redemptions PartnershipCodeRedemption[]

  @@unique([market, key])
  @@index([status, endsAt])
  @@index([campaignId])
}

model PartnershipCode {
  id              String    @id
  programId       String
  codeHash        String    @unique
  label           String
  maxRedemptions  Int
  redeemedCount   Int       @default(0)
  expiresAt       DateTime?
  status          String    @default("ACTIVE") // ACTIVE REVOKED
  createdBy       String
  createdAt       DateTime  @default(now())

  program PartnershipProgram @relation(fields: [programId], references: [id])

  @@index([programId, status])
}

/// Append-only (trigger, maintenance bypass for erasure). One per person and program. The trigger enforces the program budget, the code limit and that the lot was issued for this program's campaign.
model PartnershipCodeRedemption {
  id             String   @id
  programId      String
  codeId         String
  subHash        String
  lotId          String   @unique
  amountMinor    Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  program PartnershipProgram @relation(fields: [programId], references: [id])

  @@unique([programId, subHash])
  @@index([programId, createdAt])
}
