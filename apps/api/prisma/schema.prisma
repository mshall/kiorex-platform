  @@id([householdId, memberSub])
  @@index([memberSub])
}

/// Where a refund went: ORIGINAL (default) or CREDIT. Immutable once written (trigger; erasure may anonymise the subject inside the maintenance functions only).
model RefundDestinationChoice {
