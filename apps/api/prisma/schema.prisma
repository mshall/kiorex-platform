/// GRW-P3-E: a journey built in the constrained builder. A published graph is immutable (trigger LifecycleJourneyDefinition_guard); only the kill switch and PUBLISHED -> RETIRED may change.
/// One PUBLISHED version per (market, key): partial unique index in the migration. Maker-checker is a CHECK (approver differs from the author).
model LifecycleJourneyDefinition {
  id          String    @id @default(cuid())
  market      String    @default("EG")
  key         String
  version     Int       @default(1)
  status      String    @default("DRAFT") // DRAFT PENDING_APPROVAL PUBLISHED RETIRED
  name        String    @default("")
  graph       Json
  checksum    String
  createdBy   String
  submittedAt DateTime?
  approvedBy  String?
  publishedAt DateTime?
  retiredAt   DateTime?
  killedAt    DateTime?
  killedBy    String?
  killReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  runLogs LifecycleJourneyRunLog[]

  @@unique([market, key, version])
  @@index([market, status])
}

/// GRW-P3-E: COUNTS ONLY, one row per journey and market day. No person, no message id.
model LifecycleJourneyRunLog {
  id           String   @id @default(cuid())
  definitionId String
  market       String   @default("EG")
  day          DateTime @db.Date
  enrolled     Int      @default(0)
