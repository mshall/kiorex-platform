  slaDueAt   DateTime
  createdAt  DateTime  @default(now())
  /// GRW-P2-D: the redacted transcript handed to the human (turn text already passed redactPhi), the close note and who closed it.
  transcript Json      @default("[]")
  closedAt   DateTime?
  closedBy   String?

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, slaDueAt])
}

/// GRW-P2-D: one-time confirmation nonces behind the Confirm / Cancel buttons. Only the sha256 of the nonce is stored; a nonce is bound to one session, one subject and one target.
model AssistantConfirmation {
  id        String    @id @default(cuid())
