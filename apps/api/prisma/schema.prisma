  channel      String
  templateKey  String
  decision     String // SEND SKIP
  reason       String
  at           DateTime @default(now())
  messageLogId String?

  @@index([sub, at])
  @@index([journeyKey, step, at])
}

/// k-anonymous counts only.
model LifecycleSegmentSnapshot {
  day         DateTime @db.Date
  market      String   @default("EG")
  segmentKey  String
  countBucket String

  @@id([day, market, segmentKey])
}

model AssistantSession {
  id                    String    @id @default(cuid())
  market                String    @default("EG")
  channelConversationId String    @unique
  sub                   String?
  phoneHash             String
  state                 String    @default("START")
  language              String    @default("ar")
  consentVersion        String    @default("")
  tokenBudgetUsed       Int       @default(0)
  costMinorUsed         Int       @default(0)
  turns                 Int       @default(0)
  lastToolAt            DateTime?
  escalatedAt           DateTime?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  /// GRW-P2-D (fixups migration): per-session working memory (shown lists, idsSeen, clarify counter, dedupe hash). Ids and counters only, never message text or contact details.
  context               Json      @default("{}")

  turnRows      AssistantTurn[]
  escalations   AssistantEscalation[]
  confirmations AssistantConfirmation[]

