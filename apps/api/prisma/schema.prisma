model AssistantToolCall {
  id               String   @id @default(cuid())
  turnId           String
  tool             String
  argsRedacted     Json     @default("{}")
  resultKind       String
  resultRef        String?
  confirmNonceHash String?
  createdAt        DateTime @default(now())

  turn AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([createdAt])
}

model AssistantUsageDaily {
  day            DateTime @db.Date
  market         String   @default("EG")
  tokens         Int      @default(0)
  costMinor      Int      @default(0)
  conversations  Int      @default(0)
  breakerTripped Boolean  @default(false)
  updatedAt      DateTime @updatedAt

