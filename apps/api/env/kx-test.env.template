# kx-test (registry id `test`) environment template for the Kiorex platform API container. ADR-059; ENVIRONMENT_CONFIGURATION_STANDARD sections 2 to 5.
# Validate with:  node scripts/validate-env-template.mjs            (also run by the unit test src/common/env-template.unit.spec.ts)
#
# Value forms (the ONLY allowed ones, the validator rejects anything else for a secret or a host):
#   secretref:/<product>/<env>/<purpose>   a SECRET, by reference. The deploy step resolves it from the cloud secret store (App Runner runtimeEnvironmentSecrets).
#                                          Never put a secret value in this file, in git or in a pipeline log.
#   @registry                              a HOST or ORIGIN generated from _docs/registry/service-url-registry.yaml:
#                                          node scripts/emit-env-from-registry.mjs --env test   ->   .generated/env/test/api.env
#   literal                                a non-secret setting, identical for every container of the environment
# JOBS_ENABLED is per container: this file defaults it to false; kx-test.containers.json turns it on for EXACTLY ONE container (background jobs
# such as the outbox, commission and waitlist timers must not run twice).
# Data in kx-test is synthetic plus the designated real organisation (registry data_class). Providers stay MOCK until the founder approves INTEGRATION_MODES.

# --- identity of the environment (KX_* come from the generated file, listed here so the template is complete) ---
KX_ENV=@registry
KX_ENV_TAG=@registry
KX_PLANE=@registry
KX_REGISTRY_HASH=@registry

# --- runtime ---
NODE_ENV=production
PORT=4000
SITE_ENVIRONMENT=test
SITE_ROLE=all
SWAGGER_ENABLED=false
TRUSTED_PROXY_HOPS=2
# the mock PSP checkout is unauthenticated by design; allowed in the test environment only (never pilot or prod)
SANDBOX_PAYMENTS_ALLOWED=true
JOBS_ENABLED=false
PRISMA_MIGRATE_ON_BOOT=true
DB_POOL_MAX=10
DEFAULT_MARKET=EG
AWS_REGION=eu-central-1

# --- database (the container entrypoint builds DATABASE_URL from the secret; the secret is referenced, never the URL) ---
DB_SECRET_ARN=secretref:/kiorex-platform/test/database

# --- hosts and origins (generated from the registry) ---
PUBLIC_BASE_URL=@registry
PUBLIC_APP_URL=@registry
WEB_BASE_URL=@registry
SITE_CANONICAL_HOST=@registry
CORS_ORIGINS=@registry
OIDC_ISSUER=@registry
KIORLY_BASE_URL=@registry
WIDGET_HOST=@registry
WIDGET_EMBED_HOST=@registry
WIDGET_PRODUCTION_HOST=@registry
RX_VERIFY_BASE_URL=@registry
CREATIVE_CDN_HOST=@registry
PROVIDER_LINK_BASE_URL=@registry
# Outside local the API refuses to boot when any host variable above is unset (common/hosts.ts assertHostConfig). ALLOW_HOST_DEFAULTS must never appear here.

# --- identity provider ---
OIDC_AUDIENCE=kiorex-api

# --- providers: MOCK by default (go-live is a founder decision: INTEGRATION_RUNBOOK) ---
SMS_MODE=mock
EMAIL_MODE=mock
WHATSAPP_MODE=mock
PAYMENT_MODE=mock
SAFETY_DELIVERY_MODE=mock
VIDEO_MODE=mock
MAPS_MODE=mock
PUSH_MODE=mock
AI_PROVIDER=fake
STAFF_PHONE_MATCH_MODE=mock
STORAGE_MODE=local
STORAGE_LOCAL_DIR=/data/vault

# --- Kiorly clinic partner (HMAC REST, base URL is generated) ---
KIORLY_CLIENT_KEY=secretref:/kiorex-platform/test/kiorly-client-key
KIORLY_CLIENT_SECRET=secretref:/kiorex-platform/test/kiorly-client-secret
KIORLY_WEBHOOK_SECRET=secretref:/kiorex-platform/test/kiorly-webhook-secret

# --- secrets the API refuses to start without in production (names only here) ---
FIELD_ENCRYPTION_KEY=secretref:/kiorex-platform/test/field-encryption-key
PSP_FAKE_WEBHOOK_SECRET=secretref:/kiorex-platform/test/psp-fake-webhook-secret
WHATSAPP_WEBHOOK_SECRET=secretref:/kiorex-platform/test/whatsapp-webhook-secret
KIOREX_RECORD_SHARE_HMAC_SECRET=secretref:/kiorex-platform/test/record-share-hmac
RX_VERIFY_HMAC_SECRET=secretref:/kiorex-platform/test/rx-verify-hmac
PARTNER_LEAD_SIGNING_SECRET=secretref:/kiorex-platform/test/partner-lead-signing
GROWTH_LINK_TOKEN_SECRET=secretref:/kiorex-platform/test/growth-link-token
LINK_TOUCH_SIGNING_SECRET=secretref:/kiorex-platform/test/link-touch-signing
PAY_LINK_SECRET=secretref:/kiorex-platform/test/pay-link
PAYMENT_FINGERPRINT_PEPPER=secretref:/kiorex-platform/test/payment-fingerprint-pepper
