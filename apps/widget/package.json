{
  "name": "@kiorex/widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kiorex embeddable booking widget (GRW-P1-G): Preact app served from the widget host + the tiny kiorex-widget.js SDK",
  "scripts": {
    "build": "npm run build:app && npm run build:sdk && node scripts/finalize-sdk.mjs && node scripts/check-budget.mjs",
    "build:app": "vite build --config vite.config.ts",
    "build:sdk": "vite build --config vite.sdk.config.ts",
    "check:budget": "node scripts/check-budget.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
