{
  "description": "SC-06 — CloudFront / WAFv2 rule intent for public launch (implemented in infra CDK; this file is the product checklist).",
  "region": "eu-central-1",
  "rules": [
    {
      "id": "rate-public-auth",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 100 requests / 5 min per IP on /api/v1/auth/* and /api/v1/signup/*"
    },
    {
      "id": "aws-managed-common",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "AWSManagedRulesCommonRuleSet"
    },
    {
      "id": "aws-managed-known-bad-inputs",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "AWSManagedRulesKnownBadInputsRuleSet"
    },
    {
      "id": "geo-optional",
      "scope": "CloudFront",
      "action": "COUNT",
      "statement": "Optional geo match for abuse investigation (not a residency control)"
    },
    {
      "id": "rate-growth-public",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 300 requests / 5 min per IP on the public growth API",
      "paths": [
        "/api/v1/growth/v1/*"
      ],
      "rateLimit": {
        "requests": 300,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-growth-referral",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 60 requests / 5 min per IP on referral invite, claim and me (the app also limits claims to 20 per hour per person)",
      "paths": [
        "/api/v1/growth/v1/referral/*",
        "/api/v1/growth/v1/rewards/*"
      ],
      "rateLimit": {
        "requests": 60,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-growth-assistant",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 60 requests / 5 min per IP on the assistant link verification (single-use 15 minute tokens)",
      "paths": [
        "/api/v1/growth/v1/assistant/*"
      ],
      "rateLimit": {
        "requests": 60,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-growth-experiments",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 120 requests / 5 min per IP on experiment assignment and exposure (answers are cacheable per unit for 10 minutes; the cache key includes the kxe cookie)",
      "paths": [
        "/api/v1/growth/v1/experiments/*"
      ],
      "rateLimit": {
        "requests": 120,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-invite-landing",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 120 requests / 5 min per IP on invite landing pages",
      "paths": [
        "/invite/*"
      ],
      "rateLimit": {
        "requests": 120,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-widget-session",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 60 requests / 5 min per IP on widget session issue",
      "paths": [
        "/api/v1/widget/v1/*"
      ],
      "rateLimit": {
        "requests": 60,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-growth-loyalty",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 60 requests / 5 min per IP on loyalty points, exchange and partner-code redemption (the app also limits attempts per person)",
      "paths": [
        "/api/v1/growth/v1/loyalty/*"
      ],
      "rateLimit": {
        "requests": 60,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-growth-corporate",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 30 requests / 5 min per IP on corporate code redemption and verification (guess resistance; the app also limits attempts per person)",
      "paths": [
        "/api/v1/growth/v1/corporate/*"
      ],
      "rateLimit": {
        "requests": 30,
        "windowSeconds": 300
      }
    },
    {
      "id": "rate-growth-consent",
      "scope": "CloudFront",
      "action": "BLOCK",
      "statement": "Rate-based: 60 requests / 5 min per IP on the anonymous consent decision and the consent text versions (a banner needs two calls per page view)",
      "paths": [
        "/api/v1/growth/v1/consent",
        "/api/v1/growth/v1/consent/*"
      ],
      "rateLimit": {
        "requests": 60,
        "windowSeconds": 300
      }
    }
  ]
}
